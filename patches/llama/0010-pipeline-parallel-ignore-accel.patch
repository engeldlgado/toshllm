From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Engelbert <direccion@marketingweb.com.mx>
Date: Mon, 7 Sep 2026 02:14:08 -0400
Subject: [PATCH] 0010-pipeline-parallel-ignore-accel

---
 src/llama-context.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 0636f288a..9dcede009 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -436,9 +436,9 @@ llama_context::llama_context(
         if (pipeline_parallel) {
             for (auto & backend : backends) {
                 auto dev_type = ggml_backend_dev_type(ggml_backend_get_device(backend.get()));
-                if (dev_type == GGML_BACKEND_DEVICE_TYPE_CPU) {
-                    // ignore CPU backend
-                    // TODO: should we ignore ACCEL types too?
+                if (dev_type == GGML_BACKEND_DEVICE_TYPE_CPU || dev_type == GGML_BACKEND_DEVICE_TYPE_ACCEL) {
+                    // ignore CPU and ACCEL backends: BLAS is always present on macOS and reports
+                    // neither async nor events, which switched pipeline parallelism off for the GPUs
                     continue;
                 }
                 auto * dev = ggml_backend_get_device(backend.get());
