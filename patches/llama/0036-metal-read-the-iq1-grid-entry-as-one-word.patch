From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Engelbert <direccion@marketingweb.com.mx>
Date: Mon, 7 Sep 2026 02:14:15 -0400
Subject: [PATCH] 0039-metal-read-the-iq1-grid-entry-as-one-word

---
 ggml/src/ggml-metal/kernels/mul_mv.metal | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-metal/kernels/mul_mv.metal b/ggml/src/ggml-metal/kernels/mul_mv.metal
index 3ca7eb879..73cdefe8f 100644
--- a/ggml/src/ggml-metal/kernels/mul_mv.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mv.metal
@@ -2680,10 +2680,15 @@ void kernel_mul_mv_iq1_m_f32_impl(
         for (short row = 0; row < nr0; row++) {
             scale.u16 = (sc[0] >> 12) | ((sc[1] >> 8) & 0x00f0) | ((sc[2] >> 4) & 0x0f00) | (sc[3] & 0xf000);
 
-            threadgroup const uint8_t * grid1 = (threadgroup const uint8_t *)(sgrid + (qs[0] | ((qh[0] << 8) & 0x700)));
-            threadgroup const uint8_t * grid2 = (threadgroup const uint8_t *)(sgrid + (qs[1] | ((qh[0] << 4) & 0x700)));
-            threadgroup const uint8_t * grid3 = (threadgroup const uint8_t *)(sgrid + (qs[2] | ((qh[1] << 8) & 0x700)));
-            threadgroup const uint8_t * grid4 = (threadgroup const uint8_t *)(sgrid + (qs[3] | ((qh[1] << 4) & 0x700)));
+            // each grid entry is one word; reading it whole costs one bank access instead of four
+            const uint32_t g1 = sgrid[qs[0] | ((qh[0] << 8) & 0x700)];
+            const uint32_t g2 = sgrid[qs[1] | ((qh[0] << 4) & 0x700)];
+            const uint32_t g3 = sgrid[qs[2] | ((qh[1] << 8) & 0x700)];
+            const uint32_t g4 = sgrid[qs[3] | ((qh[1] << 4) & 0x700)];
+            thread const uint8_t * grid1 = (thread const uint8_t *)&g1;
+            thread const uint8_t * grid2 = (thread const uint8_t *)&g2;
+            thread const uint8_t * grid3 = (thread const uint8_t *)&g3;
+            thread const uint8_t * grid4 = (thread const uint8_t *)&g4;
 
             float2 sum = {0.f};
             for (short j = 0; j < 4; ++j) {
