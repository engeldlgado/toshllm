+        acc[1] += yl[i + 1]        * (qs[i / 2] & 0x0F00);
+        acc[2] += yl[i + HALF + 0] * (qs[i / 2] & 0x00F0);
+        acc[3] += yl[i + HALF + 1] * (qs[i / 2] & 0xF000);
