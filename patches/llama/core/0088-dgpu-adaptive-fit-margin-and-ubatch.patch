+    auto is_discrete = (bool (*)(ggml_backend_dev_t)) ggml_backend_reg_get_proc_address(
+        reg, "ggml_backend_metal_device_is_discrete");
+    return is_discrete != nullptr && is_discrete(dev);
+#else
+    (void) dev;
+    return false;
