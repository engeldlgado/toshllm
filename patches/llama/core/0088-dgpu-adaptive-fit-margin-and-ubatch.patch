+    // GGML_BACKEND_DEVICE_TYPE_GPU, so ask the Metal backend whether the card has its own
+    // VRAM (discrete/eGPU) or shares host memory (iGPU / Apple Silicon)
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    if (reg == nullptr) {
