+// pairs of weights that read the same input, which newer converters write as one tensor:
+// the rows of the first, then the rows of the second
+static const struct { const char * a; const char * b; const char * merged; } k_merged_weights[] = {
+    { "attn_qkv",     "attn_gate",      "attn_qkv_gate"       },
+    { "ssm_beta",     "ssm_alpha",      "ssm_beta_alpha"      },
+    { "hc_attn_down", "hc_attn_inject", "hc_attn_down_inject" },
+    { "hc_ffn_down",  "hc_ffn_inject",  "hc_ffn_down_inject"  },
+};
+
+static bool merged_weight_for(const std::string & name, std::string & merged, bool & tail) {
+    int il = -1;
+    int n  = 0;
+    if (sscanf(name.c_str(), "blk.%d.%n", &il, &n) != 1 || n == 0) {
+        return false;
+    }
+    const std::string part = name.substr(n);
+    for (const auto & m : k_merged_weights) {
+        for (int half = 0; half < 2; ++half) {
+            if (part == std::string(half ? m.b : m.a) + ".weight") {
+                merged = name.substr(0, n) + m.merged + ".weight";
+                tail   = half == 1;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+void llama_model_loader::add_merged_half(const std::string & name, const std::initializer_list<int64_t> & ne) {
+    std::string merged_name;
+    bool tail = false;
+    if (ne.size() != 2 || !merged_weight_for(name, merged_name, tail)) {
+        return;
+    }
+    const llama_tensor_weight * w = get_weight(merged_name.c_str());
+    if (w == nullptr) {
+        return;
+    }
+    const ggml_tensor * m = w->tensor;
+    const int64_t rows = ne.begin()[1];
+    if (m->ne[0] != ne.begin()[0] || m->ne[2] != 1 || m->ne[3] != 1 || rows <= 0 || rows >= m->ne[1]) {
+        return;
+    }
+
+    auto taken = merged_halves.find(merged_name);
+    if (taken != merged_halves.end() && taken->second + rows != m->ne[1]) {
+        throw std::runtime_error(format("%s: the halves of '%s' do not add up to its %" PRId64 " rows",
+                                        __func__, merged_name.c_str(), m->ne[1]));
+    }
+
+    if (!ctx_halves) {
+        size_t n_merged = 0;
+        for (const auto & it : weights_map) {
+            for (const auto & mw : k_merged_weights) {
+                n_merged += it.first.find(std::string(".") + mw.merged + ".") != std::string::npos;
+            }
+        }
+        ggml_init_params params = { (2*n_merged + 1)*ggml_tensor_overhead(), nullptr, true };
+        ctx_halves.reset(ggml_init(params));
+    }
+
+    ggml_tensor * half = ggml_new_tensor_2d(ctx_halves.get(), m->type, m->ne[0], rows);
+    ggml_set_name(half, name.c_str());
+    const size_t offs = w->offs + (tail ? (size_t) (m->ne[1] - rows)*m->nb[1] : 0);
+    weights_map.emplace(name, llama_tensor_weight(files.at(w->idx).get(), w->idx, offs, half));
+
+    // one file tensor gives two created ones
+    if (taken == merged_halves.end()) {
+        merged_halves.emplace(merged_name, rows);
+        n_tensors++;
+    }
+}
+
