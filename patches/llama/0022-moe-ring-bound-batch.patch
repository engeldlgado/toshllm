From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Engelbert <direccion@marketingweb.com.mx>
Date: Mon, 7 Sep 2026 02:14:10 -0400
Subject: [PATCH] 0022-moe-ring-bound-batch

---
 ggml/src/ggml-metal/ggml-metal-context.m | 9 +++++++++
 src/llama-graph.cpp                      | 6 +++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index 6dfbaa356..539753b5b 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -1603,6 +1603,15 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
                 }
             }
             staged_moe = bounded_forced || bounded_bank_size > bounded_threshold;
+            // A batch whose experts fit the ring is served entirely on the device, which is
+            // twice as fast as staging it a layer at a time through the host.
+            const struct ggml_tensor * ids = gf->nodes[i]->src[2];
+            const int n_fixed = tosh_moe_fixed_of(gf->nodes[i]->src[0]);
+            const int64_t room = n_fixed > 0 ? gf->nodes[i]->src[0]->ne[2] - n_fixed
+                                             : gf->nodes[i]->src[0]->ne[2];
+            if (ids && ids->ne[0]*ids->ne[1] <= room) {
+                staged_moe = false;
+            }
             break;
         }
     }
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index d0b971e55..ebe1fa78b 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2156,7 +2156,11 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         const bool whole_bank = bank && n_bank_experts > 0 && moe_first->ne[2] >= n_bank_experts;
         const bool split_wide = tosh_moe_fixed_of(moe_first) > 0 &&
             getenv("TOSH_MOE_BOUNDED_STAGE") != nullptr;
-        moe_cached = whole_bank || split_wide || n_tokens*n_expert_used <= moe_first->ne[2];
+        // A split bank can only admit experts into the ring, so that is the bound, not the
+        // slot count: past it the pick leaves ids at -1 and the batch reads outside the bank.
+        const int n_fixed = tosh_moe_fixed_of(moe_first);
+        const int64_t room = n_fixed > 0 ? moe_first->ne[2] - n_fixed : moe_first->ne[2];
+        moe_cached = whole_bank || split_wide || n_tokens*n_expert_used <= room;
     }
 
     ggml_tensor * expert_ids = selected_experts;
