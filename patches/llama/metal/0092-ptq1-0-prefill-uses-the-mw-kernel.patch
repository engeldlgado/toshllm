+// one 16-k panel of a PTQ1_0 row. The block is 128 weights behind one fp16 scale and the trits
+// sit in planes: qs[0..15] carry trit n of elements 16n..16n+15 for n = 0..4, qs[16..23] trit n of
+// elements 80+8n.., and qh two bytes of four trits each for elements 120..127. A 16-value panel is
+// therefore a contiguous byte run decoded at one power of three, so every lane runs the same path,
+// and the -1 of the codec moves into dbia the way PQ2_0's does.
+static inline uchar4 mw_trit4(uint u, uint p) {
+    // one byte per lane: as_type<ushort2> keeps two bytes in each lane and the 0xFF mask then
+    // drops the odd bytes, so the unpack goes through uchar4
+    const ushort4 b = ushort4(as_type<uchar4>(u));
+    const ushort4 t = (((b*ushort4(p)) & ushort4(0xFFu))*ushort4(3u)) >> 8;
+    return uchar4(t);
+}
+
+static inline uchar mw_trit(uint b, uint p) {
+    return (uchar) ((((b*p) & 0xFFu)*3u) >> 8);
+}
+
+static inline void mw_load_a1(device const char * wrow, int loop_k, bool rowok,
+                              thread float & dsc, thread float & dbia, thread uchar * q) {
+    const int bi = loop_k / 128;
+    const int il = (loop_k % 128) / 16;
+    device const block_ptq1_0 * blk = (device const block_ptq1_0 *) (wrow + (uint64_t) bi*sizeof(block_ptq1_0));
+
+    const float d = rowok ? (float) blk->d : 0.f;
+    dsc  = d;
+    dbia = -d;
+
+    if (il < 5) {
+        const uint p = MW_P3[il];
+        #pragma unroll
+        for (int i = 0; i < 4; i++) {
+            const uchar4 c = mw_trit4(*(device const uint *) (blk->qs + 4*i), p);
+            q[4*i + 0] = c.x; q[4*i + 1] = c.y; q[4*i + 2] = c.z; q[4*i + 3] = c.w;
+        }
+    } else if (il < 7) {
+        // elements 80..119: the same eight bytes carry two trit planes per panel
+        const uint b0 = *(device const uint *) (blk->qs + 16);
+        const uint b1 = *(device const uint *) (blk->qs + 20);
+        const uchar4 c0 = mw_trit4(b0, MW_P3[2*(il - 5)]);
+        const uchar4 c1 = mw_trit4(b1, MW_P3[2*(il - 5)]);
+        const uchar4 c2 = mw_trit4(b0, MW_P3[2*(il - 5) + 1]);
+        const uchar4 c3 = mw_trit4(b1, MW_P3[2*(il - 5) + 1]);
+        q[ 0] = c0.x; q[ 1] = c0.y; q[ 2] = c0.z; q[ 3] = c0.w;
+        q[ 4] = c1.x; q[ 5] = c1.y; q[ 6] = c1.z; q[ 7] = c1.w;
+        q[ 8] = c2.x; q[ 9] = c2.y; q[10] = c2.z; q[11] = c2.w;
+        q[12] = c3.x; q[13] = c3.y; q[14] = c3.z; q[15] = c3.w;
+    } else {
+        // elements 112..119 are trit 4 of the same eight bytes, 120..127 the four trits of qh
+        const uchar4 c0 = mw_trit4(*(device const uint *) (blk->qs + 16), 81u);
+        const uchar4 c1 = mw_trit4(*(device const uint *) (blk->qs + 20), 81u);
+        q[ 0] = c0.x; q[ 1] = c0.y; q[ 2] = c0.z; q[ 3] = c0.w;
+        q[ 4] = c1.x; q[ 5] = c1.y; q[ 6] = c1.z; q[ 7] = c1.w;
+        #pragma unroll
+        for (int i = 0; i < 8; i++) {
+            q[8 + i] = mw_trit((uint) blk->qh[i & 1], MW_P3[i >> 1]);
+        }
+    }
+}
