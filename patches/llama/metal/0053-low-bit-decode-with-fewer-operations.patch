+MV_V2_GRID_KERNEL(iq2_xs, N_R0_IQ2_XS, "kernel_mul_mv_iq2_xs_f32_v2")
+MV_V2_GRID_KERNEL(iq2_xs, 2, "kernel_mul_mv_iq2_xs_f32_v2_r2")
+MV_V2_GRID_KERNEL(iq2_xs, 8, "kernel_mul_mv_iq2_xs_f32_v2_r8")
