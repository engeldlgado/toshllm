+MV_V2_GRID_KERNEL(iq1_s, N_R0_IQ1_S, "kernel_mul_mv_iq1_s_f32_v2")
+MV_V2_GRID_KERNEL(iq1_s, 2, "kernel_mul_mv_iq1_s_f32_v2_r2")
+MV_V2_GRID_KERNEL(iq1_s, 8, "kernel_mul_mv_iq1_s_f32_v2_r8")
