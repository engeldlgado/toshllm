+// one 16-k panel of a PQ2_0 row.  The block is 128 weights with one fp16 scale, so a panel is
+// exactly one il slice: 4 quant bytes at a 2-byte offset, and the scale read once per 8 panels.
+// The values carry no bias, so the -1 of the codec moves into dbia and the store stays one fma.
+static inline void mw_load_a2(device const char * wrow, int loop_k, bool rowok,
+                              thread float & dsc, thread float & dbia, thread uchar * q) {
+    const int bi = loop_k / 128;
+    const int il = (loop_k % 128) / 16;
+    device const block_pq2_0 * blk = (device const block_pq2_0 *) (wrow + (uint64_t) bi*sizeof(block_pq2_0));
+
+    device const ushort * wq = (device const ushort *) (blk->qs + 4*il);
+    const uint w = (uint) wq[0] | ((uint) wq[1] << 16);
+
+    const float d = rowok ? (float) blk->d : 0.f;
+    dsc  = d;
+    dbia = -d;
+
+    #pragma unroll
+    for (int i = 0; i < MW_KT; i++) {
+        q[i] = (uchar) ((w >> (2*i)) & 3u);
+    }
+}
