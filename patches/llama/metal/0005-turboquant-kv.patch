+        // Normalize and rotate the full 128-element group
+        float norm_sq = 0.0f;
+        for (int j = 0; j < QK_TURBO3_GROUP; j++) norm_sq += grp_src[j] * grp_src[j];
+        float grp_norm = sqrt(norm_sq);
