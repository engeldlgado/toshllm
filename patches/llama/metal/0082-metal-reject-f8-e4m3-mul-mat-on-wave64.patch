+// Supported types for wave64 (AMD Polaris/Vega) mul_mat / mul_mat_id.
+// allow_mv_only = false restricts to types that have kernel_mul_mm_* (prefill) instantiations.
+static bool ggml_metal_supports_wave64_mul_mat_type(const struct ggml_tensor * op, bool allow_mv_only) {
+    if (!op->src[0] || !op->src[1]) {
+        return false;
+    }
+    if (op->src[1]->type != GGML_TYPE_F32 &&
+        !(op->src[1]->type == GGML_TYPE_F16 && op->src[0]->type == GGML_TYPE_F16)) {
+        return false;
+    }
+    switch (op->src[0]->type) {
+        case GGML_TYPE_F16:
+        case GGML_TYPE_F32:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+            return true;
+        // Decode-only (mul_mv) quant types — no kernel_mul_mm_* shaders exist
+        case GGML_TYPE_Q1_0:
+        case GGML_TYPE_Q2_0:
+        case GGML_TYPE_PQ2_0:
+        case GGML_TYPE_PTQ1_0:
+            return allow_mv_only;
+        default:
+            return false;
+    }
+}
