+    // exists, so every other card keeps the w64 tile; TOSH_MM_W64_ENABLE reaches it either way.
+    // the wide 64-lane tile is instantiated for the quantized types and f16, not for bf16, f32,
+    // q1_0, q2_0 or tq2_0: asking for one of those aborts in the library lookup, so they keep the
+    // narrow kernel
+    const bool w64_wide_ok = !wide || (tsrc0 != GGML_TYPE_BF16 && tsrc0 != GGML_TYPE_F32 &&
