+        case GGML_TYPE_Q4_K: nsg = N_SG_Q4_K; nr0 = N_R0_Q4_K; break;
+        case GGML_TYPE_Q5_K: nsg = N_SG_Q5_K; nr0 = N_R0_Q5_K; break;
+        case GGML_TYPE_Q8_0: nsg = N_SG_Q8_0; nr0 = N_R0_Q8_0; break;
