 }
 
 Q4_K_MV_NC_W64(8, 2)
+// three columns in one pass: without these the q4_K batch falls through to ext and
+// reads and unpacks each block once per column, which is 10.19's 1.83x against 1.16x
+Q4_K_MV_NC_W64(8, 3)
+// three columns in one pass: without these the q4_K batch falls through to ext and
+// reads and unpacks each block once per column, which is 10.19's 1.83x against 1.16x
+Q4_K_MV_NC_W64(4, 3)
 
