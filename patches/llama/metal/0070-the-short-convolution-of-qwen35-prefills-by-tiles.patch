diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 3421e85..01f6454 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -2070,16 +2070,40 @@ int ggml_metal_op_ssm_conv(ggml_metal_op_t ctx, int idx) {
         /*.ne2  =*/ ne2,
         /*.nb0  =*/ nb0,
         /*.nb1  =*/ nb1,
         /*.nb2  =*/ nb2,
     };
 
     const ggml_metal_buffer_id bid_dst = ggml_metal_get_buffer_id(n_fuse > 1 ? ctx->node(idx + n_fuse - 1) : op);
 
+    // prefill by tiles of 64 channels x 32 tokens, both sides coalesced
+    const ggml_metal_device_props * props_ssm = ggml_metal_device_get_props(ctx->dev);
+    if (props_ssm->simd_width == 32 && !props_ssm->has_unified_memory && ne1 > 1 && ne10 <= 8 && nb00 == sizeof(float) && nb0 == sizeof(float) && TOSH_ENV("TOSH_SSM_CONV_TILED_DISABLE") == nullptr) {
+        char name[128];
+        snprintf(name, sizeof(name), "kernel_ssm_conv_f32_f32_tiled_nc=%d_silu=%d", (int) ne10, use_silu ? 1 : 0);
+        ggml_metal_pipeline_with_params pipeline = ggml_metal_library_get_pipeline(lib, name);
+        if (!pipeline.pipeline) {
+            ggml_metal_cv_t cv = ggml_metal_cv_init();
+            ggml_metal_cv_set_int16(cv, 1,              FC_SSM_CONV + 0);
+            ggml_metal_cv_set_bool (cv, use_silu,       FC_SSM_CONV + 1);
+            ggml_metal_cv_set_int32(cv, (int32_t) ne10, FC_SSM_CONV + 2);
+            pipeline = ggml_metal_library_compile_pipeline(lib, "kernel_ssm_conv_f32_f32_tiled", name, cv);
+            ggml_metal_cv_free(cv);
+        }
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op->src[0]), 1);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op->src[1]), 2);
+        ggml_metal_encoder_set_buffer(enc, bid_dst, 3);
+        ggml_metal_encoder_set_threadgroup_memory_size(enc, GGML_PAD(64*(32 + ne10 - 1)*sizeof(float), 16), 0);
+        ggml_metal_encoder_dispatch_threadgroups(enc, (ne01 + 63)/64, (ne1 + 31)/32, ne02, 256, 1, 1);
+        return n_fuse;
+    }
+
     // Use batched kernel for prefill (ne1 > 1) to reduce threadgroup dispatch overhead
     const bool use_batched = (ne1 > 1);
 
     if (use_batched) {
         // Determine the smallest power of 2 that's >= ne1, but <= 256
         int BATCH_SIZE;
         if      (ne1 > 128) BATCH_SIZE = 256;
         else if (ne1 > 64 ) BATCH_SIZE = 128;
diff --git a/ggml/src/ggml-metal/kernels/ssm.metal b/ggml/src/ggml-metal/kernels/ssm.metal
index 1b39578..0001daa 100644
--- a/ggml/src/ggml-metal/kernels/ssm.metal
+++ b/ggml/src/ggml-metal/kernels/ssm.metal
@@ -596,8 +596,60 @@ kernel void kernel_ssm_scan_ssd_mma_f32(
             }
             s_buff[idx] = chunk_decay * state[idx] + state_c;
         }
 
         // All state tiles must be visible before the next chunk consumes s_buff as S_prev.
         threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
     }
 }
+
+// prefill: a threadgroup takes 64 channels x 32 tokens; the input rows go through threadgroup memory so that both
+// the reads (along time) and the writes (along the channels) coalesce
+kernel void kernel_ssm_conv_f32_f32_tiled(
+        constant ggml_metal_kargs_ssm_conv & args,
+        device const  void * src0,
+        device const  void * src1,
+        device       float * dst,
+        threadgroup  float * sm [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]]) {
+    const int nc = FC_ssm_conv_nc;
+    const int r0 = tgpig.x*64;
+    const int t0 = tgpig.y*32;
+    const int i3 = tgpig.z;
+    const int W  = 32 + nc - 1;
+
+    for (int e = tiitg; e < 64*W; e += 256) {
+        const int r  = e / W;
+        const int j  = e % W;
+        const int ir = r0 + r;
+        const int it = t0 + j;
+        sm[e] = ir < args.ne01 && it < args.ne00 ?
+            ((device const float *) ((device const char *) src0 + ir*args.nb01 + i3*args.nb02))[it] : 0.0f;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const int r  = tiitg & 63;
+    const int ir = r0 + r;
+    if (ir >= args.ne01) {
+        return;
+    }
+
+    float c[8];
+    device const float * cw = (device const float *) ((device const char *) src1 + ir*args.nb11);
+    FOR_UNROLL (short i = 0; i < 8; ++i) {
+        c[i] = i < nc ? cw[i] : 0.0f;
+    }
+
+    const int jb = (tiitg >> 6)*8;
+    FOR_UNROLL (short j = 0; j < 8; ++j) {
+        const int t = t0 + jb + j;
+        if (t >= args.ne1) {
+            break;
+        }
+        float s = 0.0f;
+        FOR_UNROLL (short i = 0; i < 8; ++i) {
+            s += i < nc ? sm[r*W + jb + j + i]*c[i] : 0.0f;
+        }
+        *(device float *) ((device char *) dst + ir*args.nb0 + t*args.nb1 + i3*args.nb2) = FC_ssm_conv_silu ? s/(1.0f + exp(-s)) : s;
+    }
+}
