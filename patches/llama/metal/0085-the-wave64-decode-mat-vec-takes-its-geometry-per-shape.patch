+        yh[0] = yc.x; yh[1] = yc.y; yh[2] = yc.z; yh[3] = yc.w;
+        yh[4] = yd.x; yh[5] = yd.y; yh[6] = yd.z; yh[7] = yd.w;
+
+        const float4 sumy = { ya.x + ya.y + ya.z + ya.w, yb.x + yb.y + yb.z + yb.w,
