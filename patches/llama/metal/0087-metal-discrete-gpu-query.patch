 // backend device
 
+// exported via get_proc_address so common/fit.cpp can tell a card with its own VRAM
+// (discrete AMD dGPU, eGPU) from a unified-memory iGPU (Apple Silicon, Intel iGPU)
+// without string-matching device names: every Metal device is named "MTL<n>" and
+// reports GGML_BACKEND_DEVICE_TYPE_GPU, only has_unified_memory separates them
+static bool ggml_backend_metal_device_is_discrete(ggml_backend_dev_t dev) {
+    if (dev == nullptr || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+        return false;
+    }
+    const ggml_metal_device_props * props_dev = ggml_metal_device_get_props((ggml_metal_device_t) dev->context);
+    return !props_dev->has_unified_memory;
+}
+
 static const char * ggml_backend_metal_device_get_name(ggml_backend_dev_t dev) {
     ggml_metal_device_t ctx_dev = (ggml_metal_device_t)dev->context;
 
     const ggml_metal_device_props * props_dev = ggml_metal_device_get_props(ctx_dev);
 
     return props_dev->name;
 }
 
