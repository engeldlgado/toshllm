 // TQ1_0/TQ2_0 have no Metal kernels at all: claiming them compiles a pipeline that does
 // not exist, which aborts instead of falling back to the CPU backend
 static bool ggml_metal_type_is_ternary(enum ggml_type t) {
     return t == GGML_TYPE_TQ1_0 || t == GGML_TYPE_TQ2_0;
 }
 
+// Supported src0 types on wave64 (AMD Polaris/Vega) for mul_mat / mul_mat_id.
+static bool ggml_metal_supports_wave64_mul_mat_type(enum ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_F16:
+        case GGML_TYPE_F32:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_IQ3_S:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q1_0:
+        case GGML_TYPE_Q2_0:
+        case GGML_TYPE_PQ2_0:
+        case GGML_TYPE_PTQ1_0:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Wave64 type and src1 precision gate mirroring ggml_metal_supports_mul_mat_op:
+// mm / mm_id support F32 and F16 src1 (except BF16 weights); mv accepts F16 src1 only for F16 x F16.
+static bool ggml_metal_supports_wave64_mul_mat_op(
+        const struct ggml_tensor * op,
+        bool src0_f16_has_mv,
+        bool mm_path) {
+    if (!ggml_metal_supports_wave64_mul_mat_type(op->src[0]->type)) {
+        return false;
+    }
+    if (op->src[1]->type == GGML_TYPE_F32) {
+        return true;
+    }
+    if (op->src[1]->type != GGML_TYPE_F16 || op->src[0]->type == GGML_TYPE_BF16) {
+        return false;
+    }
+    return mm_path || (src0_f16_has_mv && op->src[0]->type == GGML_TYPE_F16);
+}
