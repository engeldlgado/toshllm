+    }
+
+    auto pipeline = ggml_metal_library_get_pipeline_mul_mv_id_mxfp4_swiglu_oai(ctx->lib);
+
+    const ggml_tensor * w = gate->src[0];
+
+    ggml_metal_kargs_mul_mv_id_swiglu_oai args = {
+        /*.mv =*/ {
