+            /*.nei1 =*/ (int32_t) ids->ne[1],
+            /*.nbi1 =*/ ids->nb[1],
+            /*.ne00 =*/ (int32_t) w->ne[0],
+            /*.ne01 =*/ (int32_t) w->ne[1],
+            /*.ne02 =*/ (int32_t) w->ne[2],
+            /*.nb00 =*/ w->nb[0],
+            /*.nb01 =*/ w->nb[1],
+            /*.nb02 =*/ w->nb[2],
+            /*.ne10 =*/ (int32_t) x->ne[0],
+            /*.ne11 =*/ (int32_t) x->ne[1],
+            /*.ne12 =*/ (int32_t) x->ne[2],
+            /*.ne13 =*/ (int32_t) x->ne[3],
+            /*.nb10 =*/ x->nb[0],
+            /*.nb11 =*/ x->nb[1],
+            /*.nb12 =*/ x->nb[2],
+            /*.ne0  =*/ (int32_t) gate->ne[0],
+            /*.ne1  =*/ (int32_t) gate->ne[1],
