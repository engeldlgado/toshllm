+
+        yl[0] = ya.x; yl[1] = ya.y; yl[2] = ya.z; yl[3] = ya.w;
+        yl[4] = yb.x; yl[5] = yb.y; yl[6] = yb.z; yl[7] = yb.w;
+        yh[0] = yc.x; yh[1] = yc.y; yh[2] = yc.z; yh[3] = yc.w;
