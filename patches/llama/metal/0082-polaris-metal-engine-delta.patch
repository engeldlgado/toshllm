+                acc1[3] += yl[2*i + 5] * (qv1[i] & 0xF000);
+                acc2[0] += yh[2*i + 0] * (qv2[i] & 0x000F);
+                acc2[1] += yh[2*i + 1] * (qv2[i] & 0x0F00);
+                acc2[2] += yh[2*i + 4] * (qv2[i] & 0x00F0);
