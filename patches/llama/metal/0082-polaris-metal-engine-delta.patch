+            FOR_UNROLL (short i = 0; i < 2; ++i) {
+                acc1[0] += yl[2*i + 0] * (qv1[i] & 0x000F);
+                acc1[1] += yl[2*i + 1] * (qv1[i] & 0x0F00);
