+    uint16_t sc16[4];
+    thread const uint8_t * sc8 = (thread const uint8_t *)sc16;
+
+    for (int ib = ix; ib < nb; ib += NG) {
+        float4 ya;
+        float4 yb;
+        float4 yc;
+        float4 yd;
