 bool ggml_metal_add_inplace_async(ggml_metal_t ctx, struct ggml_tensor * acc, const struct ggml_tensor * add) {
     return ggml_metal_add_inplace_into(ctx, nil, acc, add);
 }
 
+// TOSH_MGPU_PEER_MIN_BATCH, the same knob the copy path reads: below it a crossing is all
+// latency and the shared host block is faster.
+static int64_t ggml_metal_peer_min_batch(void) {
+    static int64_t v = -1;
+    if (v < 0) {
+        const char * s = getenv("TOSH_MGPU_PEER_MIN_BATCH");
+        v = s ? atoll(s) : 32;
+    }
+    return v;
+}
+
+// TOSH_MGPU_HOLD=1 leaves the exchange's command buffer open so whatever the graph encodes
+// next lands in it, trading a later start for one fewer submission. Measured neutral on the
+// Vega II Duo (991.3 against 990.8 pp512, 47.96 against 47.90 tg128): the submission is not on
+// the critical path, the card is already waiting on the partner's event. Kept as a switch.
+static bool ggml_metal_collective_hold(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char * s = getenv("TOSH_MGPU_HOLD");
+        v = (s && s[0] == '1') ? 1 : 0;
+    }
+    return v == 1;
+}
