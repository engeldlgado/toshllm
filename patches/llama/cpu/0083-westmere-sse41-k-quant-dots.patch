+//     facc += (dx * y->d) * cvt(acc) + (dminx * y->d) * cvt(pr)
+//
+// as four lanes at a time. Nothing is extracted until the row is finished. This is a different
+// rounding order than the dots (which fold eight float lanes at the very end), so it is validated
+// against them per element, not assumed.
+//
+
+
+void ggml_mul_mat_q4_K_q8_K_tokens(int n, float * GGML_RESTRICT s, size_t hs,
+        const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, size_t hy, int nt) {
+    assert(n % QK_K == 0);
+    assert(nt > 0);
+
+    const int nb = n / QK_K;
+    const int B  = GGML_QK_TOKENS_BATCH;
+
+#if defined(__SSE4_1__) && !defined(__AVX__)
+
+    static const uint32_t kmask1 = 0x3f3f3f3f;
+    static const uint32_t kmask2 = 0x0f0f0f0f;
+    static const uint32_t kmask3 = 0x03030303;
+
+    const __m128i m4 = _mm_set1_epi8(0xF);
+    const __m128i m2 = _mm_set1_epi8(0x2);
+
+    int t = 0;
+    for (; t + B <= nt; t += B) {
+        __m128i acc[B];
+        __m128  facc[B];
+
+        for (int u = 0; u < B; ++u) {
+            acc[u]  = _mm_setzero_si128();
+            facc[u] = _mm_setzero_ps();
+        }
+
+        for (int i = 0; i < nb; ++i) {
+            const block_q4_K * GGML_RESTRICT b = (const block_q4_K *) vx + i;
+
+            uint32_t utmp[4];
+            memcpy(utmp, b->scales, 12);
+            utmp[3] = ((utmp[2] >> 4) & kmask2) | (((utmp[1] >> 6) & kmask3) << 4);
+            const uint32_t uaux = utmp[1] & kmask1;
+            utmp[1] = (utmp[2] & kmask2) | (((utmp[0] >> 6) & kmask3) << 4);
+            utmp[2] = uaux;
+            utmp[0] &= kmask1;
+
+            const __m128i utmps   = _mm_set_epi32(utmp[3], utmp[2], utmp[1], utmp[0]);
+            const __m128i scales = _mm_cvtepu8_epi16(utmps);
+            const __m128i mins   = _mm_cvtepu8_epi16(_mm_unpackhi_epi64(utmps, utmps));
+
+            const float dx    =  GGML_CPU_FP16_TO_FP32(b->d);
+            const float dminx = -GGML_CPU_FP16_TO_FP32(b->dmin);
+
+            for (int u = 0; u < B; ++u) {
+                acc[u] = _mm_setzero_si128();
+            }
+
+            const uint8_t * GGML_RESTRICT q4 = b->qs;
+            __m128i shuffle = _mm_set1_epi16(0x0100);
+
+            for (int j = 0; j < QK_K/64; ++j) {
+                // one 32-byte weight window = two sub-blocks of 32 values: low nibbles, then high
+                const __m128i q4bits_0 = _mm_loadu_si128((const __m128i *) q4);
+                const __m128i q4bits_1 = _mm_loadu_si128((const __m128i *)(q4 + 16));
+                q4 += 32;
+
+                const __m128i q4l_0 = _mm_and_si128(q4bits_0, m4);
+                const __m128i q4l_1 = _mm_and_si128(q4bits_1, m4);
+                const __m128i q4h_0 = _mm_and_si128(_mm_srli_epi16(q4bits_0, 4), m4);
+                const __m128i q4h_1 = _mm_and_si128(_mm_srli_epi16(q4bits_1, 4), m4);
+
+                const __m128i scale_l = _mm_shuffle_epi8(scales, shuffle);
+                shuffle = _mm_add_epi16(shuffle, m2);
+                const __m128i scale_h = _mm_shuffle_epi8(scales, shuffle);
+                shuffle = _mm_add_epi16(shuffle, m2);
+
+                for (int u = 0; u < B; ++u) {
+                    // through the type, because block_q8_K begins with its float scale: qs is not
+                    // the first byte of the row and a bare byte offset would land inside d.
+                    const int8_t * GGML_RESTRICT y8 =
+                        ((const block_q8_K *) ((const char *) vy + (t + u)*hy) + i)->qs + 64*j;
+
+                    __m128i a = _mm_madd_epi16(scale_l, _mm_maddubs_epi16(q4l_0,
+                                    _mm_loadu_si128((const __m128i *) y8)));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_l, _mm_maddubs_epi16(q4l_1,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 16)))));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_h, _mm_maddubs_epi16(q4h_0,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 32)))));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_h, _mm_maddubs_epi16(q4h_1,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 48)))));
+                    acc[u] = _mm_add_epi32(acc[u], a);
+                }
+            }
+
+            for (int u = 0; u < B; ++u) {
+                const block_q8_K * GGML_RESTRICT y =
+                    (const block_q8_K *) ((const char *) vy + (t + u)*hy) + i;
+
+                // min term folded the way the dot folds it: pair the bsums, then pmaddwd against mins
+                const __m128i q8s = _mm_hadd_epi16(
+                        _mm_loadu_si128((const __m128i *) &y->bsums[0]),
+                        _mm_loadu_si128((const __m128i *) &y->bsums[8]));
+                const __m128i pr = _mm_madd_epi16(mins, q8s);
+
+                facc[u] = _mm_add_ps(facc[u], _mm_add_ps(
+                        _mm_mul_ps(_mm_set1_ps(dx    * y->d), _mm_cvtepi32_ps(acc[u])),
+                        _mm_mul_ps(_mm_set1_ps(dminx * y->d), _mm_cvtepi32_ps(pr))));
+            }
+        }
+
+        for (int u = 0; u < B; ++u) {
+            __m128 a = facc[u];
+            a = _mm_add_ps(a, _mm_movehl_ps(a, a));
+            a = _mm_add_ss(a, _mm_movehdup_ps(a));
+            *(float *) ((char *) s + (t + u)*hs) = _mm_cvtss_f32(a);
+        }
+    }
+
+    for (; t < nt; ++t) {
+        ggml_vec_dot_q4_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#else
+
+    for (int t = 0; t < nt; ++t) {
+        ggml_vec_dot_q4_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#endif
+}
+
+// q6_K in the same shape: the sub-block is 16 values and a value is four bits from ql plus two bits
+// from qh, so the decode the batch shares is a little heavier, and the (-32) offset stays an integer
+// (its term is shifted by 5 inside the i32 domain) until the single float combine.
+//
+
+void ggml_mul_mat_q6_K_q8_K_tokens(int n, float * GGML_RESTRICT s, size_t hs,
+        const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, size_t hy, int nt) {
+    assert(n % QK_K == 0);
+    assert(nt > 0);
+
+    const int nb = n / QK_K;
+    const int B  = GGML_QK_TOKENS_BATCH;
+
+#if defined(__SSE4_1__) && !defined(__AVX__)
+
+    const __m128i m3 = _mm_set1_epi8(3);
+    const __m128i m4 = _mm_set1_epi8(0xF);
+
+    int t = 0;
+    for (; t + B <= nt; t += B) {
+        __m128i acc[B];
+        __m128  facc[B];
+
+        for (int u = 0; u < B; ++u) {
+            facc[u] = _mm_setzero_ps();
+        }
+
+        for (int i = 0; i < nb; ++i) {
+            const block_q6_K * GGML_RESTRICT b = (const block_q6_K *) vx + i;
+
+            const float dx = GGML_CPU_FP16_TO_FP32(b->d);
+            const __m128i scales = _mm_loadu_si128((const __m128i *) b->scales);
+            const __m128i s16_0 = _mm_cvtepi8_epi16(scales);
+            const __m128i s16_1 = _mm_cvtepi8_epi16(_mm_bsrli_si128(scales, 8));
+
+            for (int u = 0; u < B; ++u) {
+                acc[u] = _mm_setzero_si128();
+            }
+
+            for (int g = 0; g < 2; ++g) {
+                const uint8_t * GGML_RESTRICT ql = b->ql + 64*g;
+                const uint8_t * GGML_RESTRICT qh = b->qh + 32*g;
+
+                for (int jj = 0; jj < 8; ++jj) {
+                    const __m128i q4w = _mm_loadu_si128((const __m128i *)(ql + 16*(jj & 3)));
+                    const __m128i qhw = _mm_loadu_si128((const __m128i *)(qh + 16*(jj & 1)));
+
+                    const __m128i nib = _mm_and_si128(_mm_srli_epi16(q4w, 4*(jj >> 2)), m4);
+                    const __m128i hi  = _mm_slli_epi16(
+                            _mm_and_si128(_mm_srli_epi16(qhw, 2*(jj >> 1)), m3), 4);
+                    const __m128i v   = _mm_or_si128(nib, hi);
+
+                    const __m128i sc  = _mm_set1_epi16(b->scales[8*g + jj]);
+                    const int     off = 16*(8*g + jj);
+
+                    for (int u = 0; u < B; ++u) {
+                        const int8_t * GGML_RESTRICT q8 =
+                            ((const block_q8_K *) ((const char *) vy + (t + u)*hy) + i)->qs + off;
+                        acc[u] = _mm_add_epi32(acc[u], _mm_madd_epi16(sc,
+                                    _mm_maddubs_epi16(v,
+                                        _mm_loadu_si128((const __m128i *) q8))));
+                    }
+                }
+            }
+
+            for (int u = 0; u < B; ++u) {
+                const block_q8_K * GGML_RESTRICT y =
+                    (const block_q8_K *) ((const char *) vy + (t + u)*hy) + i;
+
+                __m128i pr = _mm_add_epi32(
+                        _mm_madd_epi16(_mm_loadu_si128((const __m128i *) &y->bsums[0]), s16_0),
+                        _mm_madd_epi16(_mm_loadu_si128((const __m128i *) &y->bsums[8]), s16_1));
+
+                // 32 * sum(s_j * bsums_j), still in i32, subtracted from the block's integer sum
+                facc[u] = _mm_add_ps(facc[u], _mm_mul_ps(_mm_set1_ps(dx * y->d),
+                        _mm_cvtepi32_ps(_mm_sub_epi32(acc[u], _mm_slli_epi32(pr, 5)))));
+            }
+        }
+
+        for (int u = 0; u < B; ++u) {
+            __m128 a = facc[u];
+            a = _mm_add_ps(a, _mm_movehl_ps(a, a));
+            a = _mm_add_ss(a, _mm_movehdup_ps(a));
+            *(float *) ((char *) s + (t + u)*hs) = _mm_cvtss_f32(a);
+        }
+    }
+
+    for (; t < nt; ++t) {
+        ggml_vec_dot_q6_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#else
+
+    for (int t = 0; t < nt; ++t) {
+        ggml_vec_dot_q6_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#endif
+}
+
+//
+// Token-batched q5_K and q3_K dots, same shape as the q4_K/q6_K pair: weight-side decode shared across
+// a run of tokens, integer sums per token, one float combine per block per token. Both mirror their
+// dot body op for op - q5_K's fifth bit comes from the same shifting hmask, q3_K's sign is subtracted
+// inside the pmaddubsw pair exactly as the dot does it, which is why neither needs an extra offset
+// term of its own.
+//
+
+void ggml_mul_mat_q5_K_q8_K_tokens(int n, float * GGML_RESTRICT s, size_t hs,
+        const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, size_t hy, int nt) {
+    assert(n % QK_K == 0);
+    assert(nt > 0);
+
+    const int nb = n / QK_K;
+    const int B  = GGML_QK_TOKENS_BATCH;
+
+#if defined(__SSE4_1__) && !defined(__AVX__)
+
+    static const uint32_t kmask1 = 0x3f3f3f3f;
+    static const uint32_t kmask2 = 0x0f0f0f0f;
+    static const uint32_t kmask3 = 0x03030303;
+
+    const __m128i m4 = _mm_set1_epi8(0xF);
+    const __m128i mone = _mm_set1_epi8(1);
+    const __m128i m2 = _mm_set1_epi8(2);
+
+    int t = 0;
+    for (; t + B <= nt; t += B) {
+        __m128i acc[B];
+        __m128  facc[B];
+        float   fmin[B];
+
+        for (int u = 0; u < B; ++u) {
+            facc[u] = _mm_setzero_ps();
+            fmin[u] = 0.0f;
+        }
+
+        for (int i = 0; i < nb; ++i) {
+            const block_q5_K * GGML_RESTRICT b = (const block_q5_K *) vx + i;
+
+            uint32_t utmp[4];
+            memcpy(utmp, b->scales, 12);
+            utmp[3] = ((utmp[2] >> 4) & kmask2) | (((utmp[1] >> 6) & kmask3) << 4);
+            const uint32_t uaux = utmp[1] & kmask1;
+            utmp[1] = (utmp[2] & kmask2) | (((utmp[0] >> 6) & kmask3) << 4);
+            utmp[2] = uaux;
+            utmp[0] &= kmask1;
+
+            const __m128i utmps   = _mm_set_epi32(utmp[3], utmp[2], utmp[1], utmp[0]);
+            const __m128i scales = _mm_cvtepu8_epi16(utmps);
+            const __m128i mins   = _mm_cvtepu8_epi16(_mm_unpackhi_epi64(utmps, utmps));
+
+            const float dx    =  GGML_CPU_FP16_TO_FP32(b->d);
+            const float dminx = -GGML_CPU_FP16_TO_FP32(b->dmin);
+
+            for (int u = 0; u < B; ++u) {
+                acc[u] = _mm_setzero_si128();
+            }
+
+            const uint8_t * GGML_RESTRICT q5 = b->qs;
+            const __m128i hbits_0 = _mm_loadu_si128((const __m128i *) &b->qh[0]);
+            const __m128i hbits_1 = _mm_loadu_si128((const __m128i *) &b->qh[16]);
+
+            __m128i hmask = mone;
+            __m128i shuffle = _mm_set1_epi16(0x0100);
+            int bit = 0;
+
+            for (int j = 0; j < QK_K/64; ++j) {
+                const __m128i scale_0 = _mm_shuffle_epi8(scales, shuffle);
+                shuffle = _mm_add_epi16(shuffle, m2);
+                const __m128i scale_1 = _mm_shuffle_epi8(scales, shuffle);
+                shuffle = _mm_add_epi16(shuffle, m2);
+
+                const __m128i q5bits_0 = _mm_loadu_si128((const __m128i *) q5);
+                const __m128i q5bits_1 = _mm_loadu_si128((const __m128i *)(q5 + 16));
+                q5 += 32;
+
+                // low nibbles plus the 5th bit (sub-block 2j), then high nibbles plus the next
+                const __m128i lo_0 = _mm_add_epi8(_mm_and_si128(q5bits_0, m4),
+                        _mm_slli_epi16(_mm_srli_epi16(_mm_and_si128(hbits_0, hmask), bit), 4));
+                const __m128i lo_1 = _mm_add_epi8(_mm_and_si128(q5bits_1, m4),
+                        _mm_slli_epi16(_mm_srli_epi16(_mm_and_si128(hbits_1, hmask), bit + 1), 4));
+                hmask = _mm_slli_epi16(hmask, 1);
+                bit += 2;
+
+                const __m128i hi_0 = _mm_add_epi8(_mm_and_si128(_mm_srli_epi16(q5bits_0, 4), m4),
+                        _mm_slli_epi16(_mm_srli_epi16(_mm_and_si128(hbits_0, hmask), bit), 4));
+                const __m128i hi_1 = _mm_add_epi8(_mm_and_si128(_mm_srli_epi16(q5bits_1, 4), m4),
+                        _mm_slli_epi16(_mm_srli_epi16(_mm_and_si128(hbits_1, hmask), bit + 1), 4));
+                hmask = _mm_slli_epi16(hmask, 1);
+                bit += 2;
+
+                for (int u = 0; u < B; ++u) {
+                    const int8_t * GGML_RESTRICT y8 =
+                        ((const block_q8_K *) ((const char *) vy + (t + u)*hy) + i)->qs + 64*j;
+
+                    __m128i a = _mm_madd_epi16(scale_0, _mm_maddubs_epi16(lo_0,
+                                    _mm_loadu_si128((const __m128i *) y8)));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_0, _mm_maddubs_epi16(lo_1,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 16)))));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_1, _mm_maddubs_epi16(hi_0,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 32)))));
+                    a = _mm_add_epi32(a, _mm_madd_epi16(scale_1, _mm_maddubs_epi16(hi_1,
+                                    _mm_loadu_si128((const __m128i *)(y8 + 48)))));
+                    acc[u] = _mm_add_epi32(acc[u], a);
+                }
+            }
+
+            for (int u = 0; u < B; ++u) {
+                const block_q8_K * GGML_RESTRICT y =
+                    (const block_q8_K *) ((const char *) vy + (t + u)*hy) + i;
+
+                const __m128i q8s = _mm_hadd_epi16(
+                        _mm_loadu_si128((const __m128i *) &y->bsums[0]),
+                        _mm_loadu_si128((const __m128i *) &y->bsums[8]));
+                __m128i pr = _mm_madd_epi16(mins, q8s);
+                pr = _mm_add_epi32(pr, _mm_shuffle_epi32(pr, _MM_SHUFFLE(1, 0, 3, 2)));
+                pr = _mm_add_epi32(pr, _mm_shuffle_epi32(pr, _MM_SHUFFLE(2, 3, 0, 1)));
+                fmin[u] += (dminx * y->d) * (float) _mm_cvtsi128_si32(pr);
+
+                facc[u] = _mm_add_ps(facc[u],
+                        _mm_mul_ps(_mm_set1_ps(dx * y->d), _mm_cvtepi32_ps(acc[u])));
+            }
+        }
+
+        for (int u = 0; u < B; ++u) {
+            __m128 a = facc[u];
+            a = _mm_add_ps(a, _mm_movehl_ps(a, a));
+            a = _mm_add_ss(a, _mm_movehdup_ps(a));
+            *(float *) ((char *) s + (t + u)*hs) = _mm_cvtss_f32(a) + fmin[u];
+        }
+    }
+
+    for (; t < nt; ++t) {
+        ggml_vec_dot_q5_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#else
+
+    for (int t = 0; t < nt; ++t) {
+        ggml_vec_dot_q5_K_q8_K(n, (float *) ((char *) s + t*hs), 0, vx, 0,
+                (const char *) vy + t*hy, 0, 1);
+    }
+
+#endif
+}
+
+// q3_K: within a 128-value group there are eight 16-value tiles. A tile is two bits of qs plus a sign
+// that the dot applies as a second pmaddubsw against a 0/2-or-0/4 pattern and subtracts, so no separate
+// offset term exists here - mirror that, and the shared part is the tile build.
+//
+
+void ggml_mul_mat_q3_K_q8_K_tokens(int n, float * GGML_RESTRICT s, size_t hs,
+        const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, size_t hy, int nt) {
+    assert(n % QK_K == 0);
+    assert(nt > 0);
+
+    const int nb = n / QK_K;
+    const int B  = GGML_QK_TOKENS_BATCH;
+
+#if defined(__SSE4_1__) && !defined(__AVX__)
+
+    static const uint32_t kmask1 = 0x03030303;   // the dot uses these two and no third
+    static const uint32_t kmask2 = 0x0f0f0f0f;
+
+    const __m128i m3 = _mm_set1_epi8(3);
+    const __m128i mone = _mm_set1_epi8(1);
+    const __m128i m2 = _mm_set1_epi8(2);
+    const __m128i m32 = _mm_set1_epi8(32);
+
+    int t = 0;
+    for (; t + B <= nt; t += B) {
+        __m128i acc[B];
+        __m128  facc[B];
+
+        for (int u = 0; u < B; ++u) {
+            acc[u]  = _mm_setzero_si128();
+            facc[u] = _mm_setzero_ps();
+        }
+
+        for (int i = 0; i < nb; ++i) {
+            const block_q3_K * GGML_RESTRICT b = (const block_q3_K *) vx + i;
+
+            const uint32_t * aux = (const uint32_t *) b->scales;
+            __m128i scales128 = _mm_set_epi32(
+                    ((aux[1] >> 4) & kmask2) | (((aux[2] >> 6) & kmask1) << 4),
+                    ((aux[0] >> 4) & kmask2) | (((aux[2] >> 4) & kmask1) << 4),
+                    (aux[1] & kmask2) | (((aux[2] >> 2) & kmask1) << 4),
+                    (aux[0] & kmask2) | (((aux[2] >> 0) & kmask1) << 4));
+            scales128 = _mm_sub_epi8(scales128, m32);
+            const __m128i sc[2] = { _mm_cvtepi8_epi16(scales128),
+                                   _mm_cvtepi8_epi16(_mm_unpackhi_epi64(scales128, scales128)) };
+
+            const __m128i hbits_0 = _mm_loadu_si128((const __m128i *) &b->hmask[0]);
+            const __m128i hbits_1 = _mm_loadu_si128((const __m128i *) &b->hmask[16]);
+
+            const uint8_t * GGML_RESTRICT q3 = b->qs;
+
+            for (int j = 0; j < QK_K/128; ++j) {
+                const __m128i q3bits_0 = _mm_loadu_si128((const __m128i *) q3);
+                const __m128i q3bits_1 = _mm_loadu_si128((const __m128i *)(q3 + 16));
+                q3 += 32;
+
+                const int bit = j << 2;
+                __m128i shuffle = _mm_set1_epi16(0x0100);
+
