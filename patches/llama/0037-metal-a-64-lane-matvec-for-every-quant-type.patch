                     nsg = 1;
@@ -1151,8 +1219,26 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv(ggml_meta
         case GGML_TYPE_Q4_K:
             {
                 // small matrices: one simdgroup with 4 rows amortizes the
