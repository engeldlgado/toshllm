From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Engelbert <direccion@marketingweb.com.mx>
Date: Mon, 7 Sep 2026 02:14:13 -0400
Subject: [PATCH] 0029-metal-fa-split-depth-per-head

---
 ggml/src/ggml-metal/ggml-metal-ops.cpp | 28 +++++++++++++++++++++++---
 1 file changed, 25 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index e5435df0f..a139e6686 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -3958,10 +3958,32 @@ int ggml_metal_op_flash_attn_ext(ggml_metal_op_t ctx, int idx) {
 
         // one threadgroup per query head leaves most of the GPU idle on models with
         // few heads; split the cache across 32 and let upstream's reduce merge them
+        // head 128 also idles the card with one threadgroup per query head, but it needs a
+        // deeper cache than the wide heads before the 32-way reduce pays for itself, and the
+        // depth it turns at is not the same on both widths
+        static const int64_t wg_dk128_env = []() {
+            const char * s = getenv("TOSH_FA_WG_DK128_MIN_KV");
+            return s ? (int64_t) atoll(s) : (int64_t) -1;
+        }();
+        const int64_t wg_dk128_min_kv = wg_dk128_env >= 0 ? wg_dk128_env
+                                      : (props_dev->simd_width == 64 ? 16384 : 24576);
+        // head 64 turns at yet another depth and is not enabled by default
+        static const int64_t wg_dk64_min_kv = []() {
+            const char * s = getenv("TOSH_FA_WG_DK64");
+            return s ? (int64_t) atoll(s) : (int64_t) 0;
+        }();
+        const bool wg_width_ok = props_dev->simd_width == 32 || props_dev->simd_width == 64;
+        const bool wg_dk64  = ne00 == 64 && ne20 == 64 && wg_width_ok &&
+                              wg_dk64_min_kv > 0 && ne11 >= wg_dk64_min_kv;
+        const bool wg_dk128 = (ne00 == 128 && ne20 == 128 && wg_width_ok &&
+                               wg_dk128_min_kv > 0 && ne11 >= wg_dk128_min_kv) || wg_dk64;
+        const bool wg_wide_head =
+            ne00 == 256 || ne00 == 512 || (ne00 == 576 && ne20 == 512) ||
+            (ne00 == 320 && ne20 == 256);
         const int fa_amd_nwg =
-            (ne00 == 256 || ne00 == 512 || (ne00 == 576 && ne20 == 512) ||
-             (ne00 == 320 && ne20 == 256)) && ne01 == 1 && !has_sinks &&
-            (props_dev->simd_width == 32 || props_dev->simd_width == 64) && ne11 >= 1024 &&
+            (wg_wide_head || wg_dk128) && ne01 == 1 && !has_sinks &&
+            (props_dev->simd_width == 32 || props_dev->simd_width == 64) &&
+            (wg_dk128 || ne11 >= 1024) &&
             getenv("TOSH_FA_WG_DISABLE") == NULL ? 32 : 1;
 
         char fa_amd_wg_pipeline[96];
