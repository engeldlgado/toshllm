+    auto reduce = [&](size_t j_dst) {
+        ggml_metal_t ctx = (ggml_metal_t) comm_ctx->backends[j_dst]->context;
+        GGML_ASSERT(ggml_metal_add_inplace_async(ctx, tensors[j_dst], &tmp[j_dst]));
+        reduced = true;
+    };
