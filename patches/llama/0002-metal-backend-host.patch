+        GGML_ASSERT(ggml_backend_metal_cpy_tensor_async_ex(comm_ctx->backends[j_src], comm_ctx->backends[j],
+                                                          tensors[j_src], tensors[j], prefer_events,
+                                                          /*hold_dst =*/ false));
+    }
