+    size_t step = 0;
+    if (n_backends > 2*offset_max) {
+        for (size_t j_src = 2*offset_max; j_src < n_backends; j_src++) {
+            if (!push(j_src, j_src - 2*offset_max, step, hold_dst)) {
+                return false;
+            }
