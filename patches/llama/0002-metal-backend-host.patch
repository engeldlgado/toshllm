+            continue;
+        }
+
+        if (node->src[1] && node->src[1]->ne[dim] > max_tokens) {
+            return false;
+        }
+
+        has_experts |= node->op == GGML_OP_MUL_MAT_ID;
+    }
+
+    return has_experts;
