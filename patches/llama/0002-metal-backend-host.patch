+    // Ends-with (not substring) so names like "*.attn_q.weight.extra" fail closed.
+    auto has_suffix = [](const char * name, const char * suffix) {
+        const size_t n = strlen(name), s = strlen(suffix);
+        return n >= s && strcmp(name + n - s, suffix) == 0;
