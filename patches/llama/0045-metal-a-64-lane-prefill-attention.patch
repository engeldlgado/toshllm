+                    av[rr] = *(threadgroup const half2 *) (sq + (qg + NQG*rr)*SQS + d0 + d);
+                }
+                for (short cc = 0; cc < NKC; ++cc) {
+                    bv[cc] = *(threadgroup const half2 *) (skv + (kg + LG*cc)*SQS + d0 + d);
+                }
+                for (short rr = 0; rr < NQR; ++rr) {
+                    for (short cc = 0; cc < NKC; ++cc) {
