+    double                      reserve_without_head_pref,
+    std::string               * reason_out      = nullptr,
+    double                      mtp_arena_share = 0.20);
+
+// Finalizes Pass 1 against Pass 0: updates p.reason when Turbo4 wins, or restores p0_plan and
+// rebinds sel to p.candidates when Turbo4 loses. Returns true iff Turbo4 was kept.
+bool tosh_plan_resolve_turbo_pass(
+    tosh_plan                 & p,
+    const tosh_plan_candidate *& sel,
+    const tosh_plan           & p0_plan,
+    const tosh_plan_candidate & p0_cand,
