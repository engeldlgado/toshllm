diff --git a/common/tosh-plan.cpp b/common/tosh-plan.cpp
index c5e774e..c0fa5e9 100644
--- a/common/tosh-plan.cpp
+++ b/common/tosh-plan.cpp
@@ -1025,7 +1025,14 @@ bool tosh_plan_apply(common_params & params, tosh_plan * out) {
     // experts on the host lose more than the head gains: every reserve, the head's last, is
     // tried for the GPU modes before any of them settles for whole layers on the host.
     // Pass 0 tries the GPU modes, pass 1 the same with turbo4 where allowed, pass 2 adds the host.
-    for (size_t pass = 0; pass < 3 && sel == nullptr; ++pass) {
+    // When pass 0 only fits in a constrained dmoe plan (lowered display reserve, dropped MTP head,
+    // or starved expert arena), pass 1 also tests turbo4 for a better plan.
+    const double reserve_without_head_pref = mtp_mib > 0 ? reserves[n_with_head] : reserve_pref;
+    const double max_share = env_mib("TOSH_AUTO_MTP_ARENA_SHARE", 0.20);
+    tosh_plan p0_plan;
+    tosh_plan_candidate p0_cand;
+    bool have_p0 = false;
+    for (size_t pass = 0; pass < 3 && (sel == nullptr || (pass == 1 && have_p0)); ++pass) {
     const bool turbo = pass == 1;
     if (turbo) {
         if (!turbo_fallback || force == "legacy") continue;
@@ -1034,9 +1041,16 @@ bool tosh_plan_apply(common_params & params, tosh_plan * out) {
             probe_kv(kvs.size() - 1);
             turbo_probed = true;
         }
+        if (have_p0) {
+            sel = nullptr;
+            p.mtp_head_dropped = false;
+            p.mtp_head_arena   = false;
+            p.fallback.clear();
+            p.reason.clear();
+        }
     }
     const ggml_type ka = turbo ? GGML_TYPE_TURBO4_0 : kvs[0];
-    const ggml_type kb = !turbo && kvs.size() > 1 ? kvs[1] : GGML_TYPE_COUNT;
+    const ggml_type kb = !turbo && kvs.size() > 1 && kvs[1] != GGML_TYPE_TURBO4_0 ? kvs[1] : GGML_TYPE_COUNT;
     for (size_t ri = 0; ri < reserves.size(); ++ri) {
         const double R = reserves[ri];
         evaluate(R);
@@ -1068,7 +1082,6 @@ bool tosh_plan_apply(common_params & params, tosh_plan * out) {
             sel = pick_dmoe();
             // with mixed execution the head's VRAM comes out of the expert arena, and past this share
             // the experts it pushes to the host cost more than its drafts save
-            static const double max_share = env_mib("TOSH_AUTO_MTP_ARENA_SHARE", 0.20);
             if (sel && !head_off && mtp_mib > 0 && max_share > 0) {
                 // the probes above already hold the head's context, so the arena without it comes from
                 // a probe of the model as it loads without the head
@@ -1093,13 +1106,24 @@ bool tosh_plan_apply(common_params & params, tosh_plan * out) {
             if (sel) p.reason = "mixed execution is not available here; expert layers go to the host";
         }
         if (sel) {
-            if (turbo) p.reason = "only a turbo4 cache keeps the experts on the GPU: faster than on the host, at some quality cost";
+            if (turbo && !have_p0) {
+                p.reason = "only a turbo4 cache keeps the experts on the GPU: faster than on the host, at some quality cost";
+            }
             p.mtp_head_dropped = head_off;
             const double R_used = p.mtp_head_arena ? reserves[n_with_head] : R;
             if (R_used < reserves[p.mtp_head_dropped ? n_with_head : 0]) p.fallback = string_format("reserve lowered to %.1f GiB", R_used/1024);
             break;
         }
     }
+    if (pass == 0 && sel != nullptr && turbo_fallback && force != "legacy" && force != "full" &&
+        tosh_plan_dmoe_should_try_turbo4(p, *sel, reserve_pref, reserve_without_head_pref)) {
+        p0_plan = p;
+        p0_cand = *sel;
+        have_p0 = true;
+    }
+    if (turbo && have_p0) {
+        tosh_plan_resolve_turbo_pass(p, sel, p0_plan, p0_cand, reserve_pref, reserve_without_head_pref, max_share);
+    }
     }
 
     if (sel == nullptr) {
@@ -1367,3 +1391,121 @@ void tosh_plan_report_load(const char * result, const char * detail) {
         fclose(fp);
     }
 }
+
+static bool tosh_plan_dmoe_tiny_arena(double arena_mib, double bank_mib) {
+    return arena_mib < std::min(2048.0, 0.25 * bank_mib);
+}
+
+double tosh_plan_reserve_deficit(
+        const tosh_plan & plan,
+        double            reserve_with_head_pref,
+        double            reserve_without_head_pref) {
+    const double target = plan.mtp_head_dropped ? reserve_without_head_pref : reserve_with_head_pref;
+    return std::max(0.0, target - plan.reserve_mib);
+}
+
+bool tosh_plan_dmoe_should_try_turbo4(
+        const tosh_plan           & p0_plan,
+        const tosh_plan_candidate & p0_cand,
+        double                      reserve_with_head_pref,
+        double                      reserve_without_head_pref) {
+    if (p0_cand.mode != "dmoe") return false;
+    return tosh_plan_reserve_deficit(p0_plan, reserve_with_head_pref, reserve_without_head_pref) > 1.0 ||
+           p0_plan.mtp_head_dropped ||
+           tosh_plan_dmoe_tiny_arena(p0_cand.arena_mib, p0_plan.bank_mib);
+}
+
+bool tosh_plan_turbo_beats_p0(
+        const tosh_plan           & p1_plan,
+        const tosh_plan_candidate * p1_sel,
+        const tosh_plan           & p0_plan,
+        const tosh_plan_candidate & p0_cand,
+        double                      reserve_with_head_pref,
+        double                      reserve_without_head_pref,
+        std::string               * reason_out,
+        double                      mtp_arena_share) {
+    if (p1_sel == nullptr || !p1_sel->valid) return false;
+    if (p1_sel->mode != "full_gpu" && p1_sel->mode != "dmoe") return false;
+    // Never discard the MTP head when Pass 0 kept it.
+    if (p1_plan.mtp_head_dropped && !p0_plan.mtp_head_dropped) return false;
+
+    const double def0 = tosh_plan_reserve_deficit(p0_plan, reserve_with_head_pref, reserve_without_head_pref);
+    const double def1 = tosh_plan_reserve_deficit(p1_plan, reserve_with_head_pref, reserve_without_head_pref);
+    // Display reserve deficit must never worsen in any branch.
+    if (def1 > def0 + 1.0) return false;
+
+    if (p1_sel->mode == "full_gpu") {
+        if (reason_out) *reason_out = "turbo4 cache fits the full model on the GPU, at some quality cost";
+        return true;
+    }
+
+    if (p1_sel->ubatch < p0_cand.ubatch) return false;
+
+    const double kc0 = p0_cand.kv_mib + p0_cand.compute_mib;
+    const double kc1 = p1_sel->kv_mib + p1_sel->compute_mib;
+
+    const bool mtp_saved = !p1_plan.mtp_head_dropped && p0_plan.mtp_head_dropped;
+    if (mtp_saved) {
+        // Strip the MTP head budget from p1_plan.reserve_mib so display headroom is compared on equal
+        // footing: require preserved display reserve, kv+compute savings, and arena cost <= mtp_arena_share.
+        const double mtp_budget = std::max(0.0, reserve_with_head_pref - reserve_without_head_pref);
+        const double disp0 = p0_plan.reserve_mib;
+        const double disp1 = std::max(0.0, p1_plan.reserve_mib - mtp_budget);
+        const double keep_share = 1.0 - std::clamp(mtp_arena_share, 0.0, 1.0);
+        const bool arena_preserved = p1_sel->arena_mib >= keep_share * p0_cand.arena_mib;
+        const bool display_kept    = disp1 >= disp0 - 1.0;
+        if (kc1 <= kc0 + 1.0 && arena_preserved && display_kept) {
+            if (reason_out) *reason_out = "turbo4 cache keeps the MTP draft head on the GPU, at some quality cost";
+            return true;
+        }
+        return false;
+    }
+
+    if (def1 + 1.0 < def0) {
+        const double recovered = def0 - def1;
+        if (kc1 <= kc0 + 1.0 && p1_sel->arena_mib + recovered >= p0_cand.arena_mib - 1.0) {
+            if (reason_out) {
+                const bool full = def1 <= 1.0;
+                *reason_out = p1_sel->ubatch > p0_cand.ubatch
+                    ? (full ? "turbo4 cache restores full VRAM headroom and batch capacity for the expert arena, at some quality cost"
+                            : "turbo4 cache improves VRAM headroom and batch capacity for the expert arena, at some quality cost")
+                    : (full ? "turbo4 cache restores full VRAM headroom for the expert arena, at some quality cost"
+                            : "turbo4 cache improves VRAM headroom for the expert arena, at some quality cost");
+            }
+            return true;
+        }
+        return false;
+    }
+
+    if (tosh_plan_dmoe_tiny_arena(p0_cand.arena_mib, p0_plan.bank_mib) &&
+        kc1 <= kc0 + 1.0 &&
+        p1_sel->arena_mib - p0_cand.arena_mib >= std::max(512.0, 0.20 * p0_cand.arena_mib)) {
+        if (reason_out) *reason_out = "turbo4 cache substantially expands the constrained expert arena, at some quality cost";
+        return true;
+    }
+    return false;
+}
+
+bool tosh_plan_resolve_turbo_pass(
+        tosh_plan                 & p,
+        const tosh_plan_candidate *& sel,
+        const tosh_plan           & p0_plan,
+        const tosh_plan_candidate & p0_cand,
+        double                      reserve_with_head_pref,
+        double                      reserve_without_head_pref,
+        double                      mtp_arena_share) {
+    std::string turbo_reason;
+    if (tosh_plan_turbo_beats_p0(p, sel, p0_plan, p0_cand, reserve_with_head_pref, reserve_without_head_pref, &turbo_reason, mtp_arena_share)) {
+        p.reason = turbo_reason;
+        return true;
+    }
+    p = p0_plan;
+    sel = nullptr;
+    for (const auto & c : p.candidates) {
+        if (c.mode == p0_cand.mode && c.kv == p0_cand.kv && c.ubatch == p0_cand.ubatch) {
+            sel = &c;
+            break;
+        }
+    }
+    return false;
+}
