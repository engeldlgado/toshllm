+            const double R_used = p.mtp_head_arena ? reserves[n_with_head] : R;
+            if (R_used < reserves[p.mtp_head_dropped ? n_with_head : 0]) p.fallback = string_format("reserve lowered to %.1f GiB", R_used/1024);
             break;
         }
     }
 
