+
+int tosh_plan_summarize_moe_banks(
+        const std::string                        & arch,
+        int                                        n_layer_nextn,
+        int                                        n_layer_all,
+        const std::vector<tosh_moe_layer_sample> & layers,
+        tosh_moe_bank_metrics                    & trunk_out,
+        tosh_moe_bank_metrics                    & with_nextn_out) {
+    auto summarize = [&](int limit) -> tosh_moe_bank_metrics {
+        tosh_moe_bank_metrics m;
+        std::vector<double> sizes;
+        const int n = std::clamp(limit, 0, (int) layers.size());
+        for (int il = 0; il < n; ++il) {
+            const auto & s = layers[il];
+            m.bank_mib += s.bank_mib;
+            m.max_tensor_mib = std::max(m.max_tensor_mib, s.max_tensor_mib);
+            m.max_fused_gate_up_mib = std::max(m.max_fused_gate_up_mib, s.fused_gate_up_mib);
+            if (s.bank_mib > 0) {
+                m.n_moe++;
+                if (std::none_of(sizes.begin(), sizes.end(), [&](double v) {
+                        return std::fabs(v - s.bank_mib) < 1e-6;
+                    })) {
+                    sizes.push_back(s.bank_mib);
+                }
+            }
+        }
+        for (double sz : sizes) m.warm_floor_mib += sz;
+        return m;
+    };
+
+    with_nextn_out = summarize(n_layer_all);
+    const bool valid_split = n_layer_all > 0 && n_layer_nextn > 0 && n_layer_nextn < n_layer_all;
+    const int n_main = valid_split ? n_layer_all - n_layer_nextn : std::max(0, n_layer_all);
+    bool has_nextn_tensors = false;
+    if (valid_split) {
+        const int check_end = std::min(n_layer_all, (int) layers.size());
+        for (int il = n_main; il < check_end; ++il) {
+            if (layers[il].has_nextn) {
+                has_nextn_tensors = true;
+                break;
+            }
+        }
+    }
+    // graniteswitch repurposes nextn_predict_layers for its attended router layer;
+    // step35 and hy_v3 load NextN expert weights with TENSOR_NOT_REQUIRED instead of mtp_flags,
+    // so the loader never skips them when load_mtp=false.
+    // bailingmoe2, exaone-moe, and dots3note unconditionally pass TENSOR_SKIP for i >= n_layer.
+    const bool always_skips = valid_split &&
+                              (arch == "bailingmoe2" || arch == "exaone-moe" || arch == "dots3note");
+    const bool exclude_inactive = always_skips ||
+                                  (arch != "graniteswitch" && arch != "step35" && arch != "hy_v3" &&
+                                   valid_split && has_nextn_tensors);
+    if (always_skips) {
+        with_nextn_out = summarize(n_main);
+    }
+    trunk_out = exclude_inactive ? summarize(n_main) : with_nextn_out;
+    return exclude_inactive ? n_main : std::max(0, n_layer_all);
+}
+
+bool tosh_plan_inspect_moe_file(
+        const char            * path,
+        bool                    include_nextn,
+        tosh_moe_bank_metrics & out,
+        std::string           * error_out) {
+    out = {};
+    if (path == nullptr || path[0] == '\0') {
+        if (error_out) *error_out = "empty model path";
+        return false;
+    }
+    const moe_info mi = read_moe_info(path, LLAMA_LAZY_MODE_AUTO);
+    if (!mi.error.empty()) {
+        if (error_out) *error_out = mi.error;
+        return false;
+    }
+    if (!mi.moe) {
+        if (error_out) *error_out = "model is not MoE";
+        return false;
+    }
+    if (error_out) error_out->clear();
+    out = mi.bank(include_nextn);
+    return true;
+}
