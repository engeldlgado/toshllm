+int main() {
+    // 1. Qwen3.8-35B-A3B layout: 40 trunk blocks (20 x 498 MiB + 20 x 432 MiB = 18,600 MiB)
+    //    plus 1 trailing NextN block (498 MiB). Inactive NextN is excluded from trunk.
+    {
+        std::vector<tosh_moe_layer_sample> layers;
+        for (int i = 0; i < 20; ++i) layers.push_back(make_layer(498.0, 166.0, 332.0, false));
+        for (int i = 0; i < 20; ++i) layers.push_back(make_layer(432.0, 144.0, 288.0, false));
+        layers.push_back(make_layer(498.0, 166.0, 332.0, /*has_nextn=*/true));
+
+        tosh_moe_bank_metrics trunk, with_nextn;
+        const int n_trunk = tosh_plan_summarize_moe_banks("qwen35moe", 1, 41, layers, trunk, with_nextn);
+        assert(n_trunk == 40);
+        assert(trunk.n_moe == 40);
+        assert(approx_equal(trunk.bank_mib, 18600.0));
+        assert(approx_equal(trunk.warm_floor_mib, 930.0));
+        assert(with_nextn.n_moe == 41);
+        assert(approx_equal(with_nextn.bank_mib, 19098.0));
+        assert(approx_equal(with_nextn.warm_floor_mib, 930.0));
+    }
+
+    // 2. Trailing NextN with unique size / larger max tensor & fused gate+up only affects with_nextn.
+    {
+        std::vector<tosh_moe_layer_sample> layers = {
+            make_layer(300.0, 100.0, 200.0, false),
+            make_layer(300.0, 100.0, 200.0, false),
+            make_layer(600.0, 250.0, 450.0, /*has_nextn=*/true),
+        };
+        tosh_moe_bank_metrics trunk, with_nextn;
+        const int n_trunk = tosh_plan_summarize_moe_banks("qwen3next", 1, 3, layers, trunk, with_nextn);
+        assert(n_trunk == 2);
+        assert(trunk.n_moe == 2);
+        assert(approx_equal(trunk.bank_mib, 600.0));
+        assert(approx_equal(trunk.max_tensor_mib, 100.0));
+        assert(approx_equal(trunk.max_fused_gate_up_mib, 200.0));
+        assert(approx_equal(trunk.warm_floor_mib, 300.0));
+
+        assert(with_nextn.n_moe == 3);
+        assert(approx_equal(with_nextn.bank_mib, 1200.0));
+        assert(approx_equal(with_nextn.max_tensor_mib, 250.0));
+        assert(approx_equal(with_nextn.max_fused_gate_up_mib, 450.0));
+        assert(approx_equal(with_nextn.warm_floor_mib, 900.0));
+    }
+
+    // 3. Multi-head NextN (nextn_predict_layers = 2) drops all trailing NextN blocks from trunk.
+    {
+        std::vector<tosh_moe_layer_sample> layers = {
+            make_layer(400.0, 150.0, 0.0, false),
+            make_layer(400.0, 150.0, 0.0, false),
+            make_layer(400.0, 150.0, 0.0, /*has_nextn=*/true),
+            make_layer(400.0, 150.0, 0.0, /*has_nextn=*/true),
+        };
+        tosh_moe_bank_metrics trunk, with_nextn;
+        const int n_trunk = tosh_plan_summarize_moe_banks("deepseek2", 2, 4, layers, trunk, with_nextn);
+        assert(n_trunk == 2);
+        assert(trunk.n_moe == 2);
+        assert(approx_equal(trunk.bank_mib, 800.0));
+        assert(with_nextn.n_moe == 4);
+        assert(approx_equal(with_nextn.bank_mib, 1600.0));
+    }
+
+    // 4. graniteswitch, step35, and hy_v3 never skip trailing NextN expert tensors when load_mtp=false.
+    {
+        std::vector<tosh_moe_layer_sample> layers = {
+            make_layer(200.0, 80.0, 0.0, false),
+            make_layer(200.0, 80.0, 0.0, /*has_nextn=*/true),
+        };
+        for (const char * arch : { "graniteswitch", "step35", "hy_v3" }) {
+            tosh_moe_bank_metrics trunk, with_nextn;
+            const int n_trunk = tosh_plan_summarize_moe_banks(arch, 1, 2, layers, trunk, with_nextn);
+            assert(n_trunk == 2);
+            assert(trunk.n_moe == 2);
+            assert(approx_equal(trunk.bank_mib, 400.0));
+            assert(with_nextn.n_moe == 2);
+            assert(approx_equal(with_nextn.bank_mib, 400.0));
+        }
+    }
+
+    // 5. bailingmoe2, exaone-moe, and dots3note always pass TENSOR_SKIP on NextN even when load_mtp=true or .nextn. markers are absent.
+    {
+        for (const char * arch : { "bailingmoe2", "exaone-moe", "dots3note" }) {
+            for (bool has_marker : { true, false }) {
+                std::vector<tosh_moe_layer_sample> layers = {
+                    make_layer(200.0, 80.0, 0.0, false),
+                    make_layer(200.0, 80.0, 0.0, has_marker),
+                };
+                tosh_moe_bank_metrics trunk, with_nextn;
+                const int n_trunk = tosh_plan_summarize_moe_banks(arch, 1, 2, layers, trunk, with_nextn);
+                assert(n_trunk == 1);
+                assert(trunk.n_moe == 1);
+                assert(with_nextn.n_moe == 1);
+                assert(approx_equal(trunk.bank_mib, 200.0));
+                assert(approx_equal(with_nextn.bank_mib, 200.0));
+            }
+        }
+    }
+
+    // 6. Standalone MTP-only file (n_layer_all == n_layer_nextn) and trunk-only file without .nextn. tensors keep all layers.
+    {
+        std::vector<tosh_moe_layer_sample> mtp_only = {
+            make_layer(250.0, 90.0, 0.0, /*has_nextn=*/true),
+        };
+        tosh_moe_bank_metrics trunk, with_nextn;
+        const int n1 = tosh_plan_summarize_moe_banks("qwen35moe", 1, 1, mtp_only, trunk, with_nextn);
+        assert(n1 == 1 && trunk.n_moe == 1 && approx_equal(trunk.bank_mib, 250.0));
+
+        std::vector<tosh_moe_layer_sample> trunk_only = {
+            make_layer(250.0, 90.0, 0.0, false),
+            make_layer(250.0, 90.0, 0.0, false),
+        };
+        const int n2 = tosh_plan_summarize_moe_banks("qwen35moe", 1, 2, trunk_only, trunk, with_nextn);
+        assert(n2 == 2 && trunk.n_moe == 2 && approx_equal(trunk.bank_mib, 500.0));
+    }
+
+    // 7. Out-of-range sample at index n_layer_all (mirrors read_moe_info's n_layer + 1 buffer)
+    //    must never be folded into with_nextn_out or trunk_out.
+    {
+        std::vector<tosh_moe_layer_sample> padded = {
+            make_layer(300.0, 100.0, 0.0, false),
+            make_layer(300.0, 100.0, 0.0, /*has_nextn=*/true),
+            make_layer(999.0, 500.0, 0.0, /*has_nextn=*/true), // index == n_layer_all (2)
+        };
+        tosh_moe_bank_metrics trunk, with_nextn;
+        const int n_trunk = tosh_plan_summarize_moe_banks("qwen35moe", 1, 2, padded, trunk, with_nextn);
+        assert(n_trunk == 1);
+        assert(trunk.n_moe == 1 && approx_equal(trunk.bank_mib, 300.0));
+        assert(with_nextn.n_moe == 2 && approx_equal(with_nextn.bank_mib, 600.0));
+
+        // Even when exempt (step35), index == n_layer_all must stay excluded.
+        const int n_step = tosh_plan_summarize_moe_banks("step35", 1, 2, padded, trunk, with_nextn);
+        assert(n_step == 2);
+        assert(trunk.n_moe == 2 && approx_equal(trunk.bank_mib, 600.0));
+        assert(with_nextn.n_moe == 2 && approx_equal(with_nextn.bank_mib, 600.0));
+    }
+
+    // 8. host_expert_layers trims NextN only when inactive & has_nextn_bank, and keeps looped layers last.
+    {
+        const auto off = tosh_plan_host_expert_layers(5, 4, true, false, 0, 0, /*use_nextn=*/false);
+        assert((off == std::vector<int>{0, 1, 2, 3}));
+        const auto on = tosh_plan_host_expert_layers(5, 4, true, false, 0, 0, /*use_nextn=*/true);
+        assert((on == std::vector<int>{0, 1, 2, 3, 4}));
+        const auto no_bank_on = tosh_plan_host_expert_layers(5, 4, /*has_nextn_bank=*/false, false, 0, 0, true);
+        assert((no_bank_on == std::vector<int>{0, 1, 2, 3}));
+
+        // Looped [1, 3) out of 5 layers with trailing NextN at 4:
+        // inactive: 0, 3 (unrepeated), then 1, 2 (repeated);
+        // active:   0, 3, 4 (unrepeated), then 1, 2 (repeated).
+        const auto looped_off = tosh_plan_host_expert_layers(5, 4, true, true, 1, 3, false);
+        assert((looped_off == std::vector<int>{0, 3, 1, 2}));
+        const auto looped_on = tosh_plan_host_expert_layers(5, 4, true, true, 1, 3, true);
+        assert((looped_on == std::vector<int>{0, 3, 4, 1, 2}));
+    }
+
+    // 9. Synthetic GGUF file inspection (single-file, fused, hy_v3, split shards, trunk-only, and error paths).
+    {
+        temp_gguf_cleanup tmp;
+        const std::string with_mtp_file   = tmp.make("-embedded.gguf");
+        const std::string trunk_only_file = tmp.make("-trunk-only.gguf");
+        const std::string hy_v3_file      = tmp.make("-hy-v3.gguf");
+        const std::string fused_file      = tmp.make("-fused.gguf");
+        const std::string dense_file      = tmp.make("-dense.gguf");
+        const std::string split_base      = tmp.make("");
+        const std::string split_1         = split_base + "-00001-of-00002.gguf";
+        const std::string split_2         = split_base + "-00002-of-00002.gguf";
+        tmp.paths.push_back(split_1);
+        tmp.paths.push_back(split_2);
+
+        write_synthetic_moe_gguf(with_mtp_file, "qwen35moe", /*n_trunk=*/4, /*n_nextn_blocks=*/1,
+                                 /*n_nextn_kv=*/1, /*include_nextn_tensor=*/true);
+        tosh_moe_bank_metrics m_off, m_on;
+        std::string err;
+        assert(tosh_plan_inspect_moe_file(with_mtp_file.c_str(), false, m_off, &err));
+        assert(err.empty());
+        assert(tosh_plan_inspect_moe_file(with_mtp_file.c_str(), true, m_on, &err));
+        assert(err.empty());
+        assert(m_off.n_moe == 4);
+        assert(m_on.n_moe == 5);
+        assert(approx_equal(m_on.bank_mib * 4.0 / 5.0, m_off.bank_mib));
+        // Wave64 gate+up fusion size on synthetic tensors (two 64x64x4 F32 tensors)
+        const double expected_gate_or_up_mib = (double) (64 * 64 * 4 * sizeof(float)) / 1048576.0;
+        assert(approx_equal(m_off.max_fused_gate_up_mib, 2.0 * expected_gate_or_up_mib, 1e-6));
+
+        // Trunk-only GGUF with stale nextn_predict_layers = 1 and no .nextn. tensors must keep all 4 layers.
+        write_synthetic_moe_gguf(trunk_only_file, "qwen35moe", /*n_trunk=*/4, /*n_nextn_blocks=*/0,
+                                 /*n_nextn_kv=*/1, /*include_nextn_tensor=*/false);
+        tosh_moe_bank_metrics m_trunk_off, m_trunk_on;
+        assert(tosh_plan_inspect_moe_file(trunk_only_file.c_str(), false, m_trunk_off, &err));
+        assert(tosh_plan_inspect_moe_file(trunk_only_file.c_str(), true, m_trunk_on, &err));
+        assert(m_trunk_off.n_moe == 4 && m_trunk_on.n_moe == 4);
+        assert(approx_equal(m_trunk_off.bank_mib, m_trunk_on.bank_mib));
+
+        // hy_v3 loads NextN expert tensors even when load_mtp=false.
+        write_synthetic_moe_gguf(hy_v3_file, "hy_v3", /*n_trunk=*/4, /*n_nextn_blocks=*/1,
+                                 /*n_nextn_kv=*/1, /*include_nextn_tensor=*/true);
+        tosh_moe_bank_metrics m_hy_off, m_hy_on;
+        assert(tosh_plan_inspect_moe_file(hy_v3_file.c_str(), false, m_hy_off, &err));
+        assert(tosh_plan_inspect_moe_file(hy_v3_file.c_str(), true, m_hy_on, &err));
+        assert(m_hy_off.n_moe == 5 && m_hy_on.n_moe == 5);
+        assert(approx_equal(m_hy_off.bank_mib, m_hy_on.bank_mib));
+
+        // Already-fused ffn_gate_up_exps.weight model leaves max_fused_gate_up_mib = 0 and counts bank_mib cleanly.
+        write_synthetic_moe_gguf(fused_file, "qwen35moe", /*n_trunk=*/2, /*n_nextn_blocks=*/1,
+                                 /*n_nextn_kv=*/1, /*include_nextn_tensor=*/true, 4, /*fused_gate_up=*/true);
+        tosh_moe_bank_metrics m_fused_off, m_fused_on;
+        assert(tosh_plan_inspect_moe_file(fused_file.c_str(), false, m_fused_off, &err));
+        assert(tosh_plan_inspect_moe_file(fused_file.c_str(), true, m_fused_on, &err));
+        assert(m_fused_off.n_moe == 2 && m_fused_on.n_moe == 3);
+        assert(approx_equal(m_fused_off.max_fused_gate_up_mib, 0.0, 1e-6));
+        assert(approx_equal(m_fused_on.bank_mib * 2.0 / 3.0, m_fused_off.bank_mib));
+
+        // Split multi-shard GGUF where shard 2 carries the trailing NextN layer.
+        write_synthetic_split_moe_gguf(split_1, split_2, "qwen35moe", /*n_trunk=*/4, /*n_nextn_blocks=*/1);
+        tosh_moe_bank_metrics m_split_off, m_split_on;
+        assert(tosh_plan_inspect_moe_file(split_1.c_str(), false, m_split_off, &err));
+        assert(err.empty());
+        assert(tosh_plan_inspect_moe_file(split_1.c_str(), true, m_split_on, &err));
+        assert(err.empty());
+        assert(m_split_off.n_moe == 4 && m_split_on.n_moe == 5);
+        assert(approx_equal(m_split_on.bank_mib * 4.0 / 5.0, m_split_off.bank_mib));
+
+        // Error paths: null/empty path, missing file, non-MoE model.
+        tosh_moe_bank_metrics m_err;
+        assert(!tosh_plan_inspect_moe_file(nullptr, false, m_err, &err) && !err.empty());
+        assert(!tosh_plan_inspect_moe_file("", false, m_err, &err) && !err.empty());
+        assert(!tosh_plan_inspect_moe_file((split_base + "-missing.gguf").c_str(), false, m_err, &err) && !err.empty());
+        write_synthetic_moe_gguf(dense_file, "llama", /*n_trunk=*/2, /*n_nextn_blocks=*/0,
+                                 /*n_nextn_kv=*/0, /*include_nextn_tensor=*/false, /*n_expert=*/0);
+        assert(!tosh_plan_inspect_moe_file(dense_file.c_str(), false, m_err, &err) && err == "model is not MoE");
+    }
+
+    std::printf("test-tosh-plan-nextn: all assertions passed\n");
+    return 0;
+}
