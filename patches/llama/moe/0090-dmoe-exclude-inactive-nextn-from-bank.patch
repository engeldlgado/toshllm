+std::vector<int> tosh_plan_host_expert_layers(
+        int  n_layer_all,
+        int  n_trunk,
+        bool has_nextn_bank,
+        bool looped,
+        int  loop_start,
+        int  loop_end,
+        bool use_nextn) {
+    const int n_limit = (use_nextn && has_nextn_bank) ? n_layer_all : n_trunk;
+    std::vector<int> order;
+    for (int pass = 0; pass < 2; ++pass) {
+        for (int il = 0; il < n_limit; ++il) {
+            const bool repeated = looped && il >= loop_start && il < loop_end;
+            if (repeated == (pass == 1)) {
+                order.push_back(il);
+            }
+        }
+    }
+    return order;
