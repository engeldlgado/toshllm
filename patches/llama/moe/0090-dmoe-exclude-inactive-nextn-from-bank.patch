+static bool approx_equal(double a, double b, double tol = 1e-4) {
+    return std::fabs(a - b) <= tol;
+}
+
+namespace {
+
+struct temp_gguf_cleanup {
+    std::vector<std::string> paths;
+
+    std::string make(const std::string & suffix) {
+        static std::atomic<uint64_t> seq{0};
+        static const uint64_t run_tag =
+            (uint64_t) std::chrono::steady_clock::now().time_since_epoch().count() ^
+            (uint64_t) std::hash<std::thread::id>{}(std::this_thread::get_id());
+        const auto dir = std::filesystem::temp_directory_path();
+        const uint64_t id = ++seq;
+        std::string p = (dir / ("test-tosh-plan-nextn-" + std::to_string(run_tag) +
+                                "-" + std::to_string(id) + suffix)).string();
+        paths.push_back(p);
+        return p;
+    }
+
+    ~temp_gguf_cleanup() {
+        for (const auto & p : paths) {
+            std::error_code ec;
+            std::filesystem::remove(p, ec);
+        }
+    }
+};
+
+} // namespace
+
+static tosh_moe_layer_sample make_layer(double bank_mib, double max_tensor_mib,
+                                        double fused_gate_up_mib = 0.0, bool has_nextn = false) {
+    tosh_moe_layer_sample s;
+    s.bank_mib = bank_mib;
+    s.max_tensor_mib = max_tensor_mib;
+    s.fused_gate_up_mib = fused_gate_up_mib;
+    s.has_nextn = has_nextn;
+    return s;
+}
+
+static void write_synthetic_moe_gguf(
+        const std::string & path,
+        const std::string & arch,
+        int                 n_trunk,
+        int                 n_nextn_blocks,
+        int                 n_nextn_kv,
+        bool                include_nextn_tensor,
+        int                 n_expert = 4,
+        bool                fused_gate_up = false) {
+    gguf_context * ctx = gguf_init_empty();
+    assert(ctx != nullptr);
+    gguf_set_val_str(ctx, "general.architecture", arch.c_str());
+    gguf_set_val_u32(ctx, (arch + ".block_count").c_str(), n_trunk + n_nextn_blocks);
+    if (n_expert > 0) {
+        gguf_set_val_u32(ctx, (arch + ".expert_count").c_str(), n_expert);
+        gguf_set_val_u32(ctx, (arch + ".expert_used_count").c_str(), 1);
+    }
+    gguf_set_val_u32(ctx, (arch + ".context_length").c_str(), 4096);
+    if (n_nextn_kv > 0) {
+        gguf_set_val_u32(ctx, (arch + ".nextn_predict_layers").c_str(), n_nextn_kv);
+    }
+
+    const int n_total = n_trunk + n_nextn_blocks;
+    ggml_init_params gp = { ggml_tensor_overhead() * (size_t) (n_total * 5 + 8), nullptr, true };
+    ggml_context * gctx = ggml_init(gp);
+    assert(gctx != nullptr);
+
+    auto add_3d = [&](const std::string & name, int64_t ne0, int64_t ne1, int64_t ne2) {
+        ggml_tensor * t = ggml_new_tensor_3d(gctx, GGML_TYPE_F32, ne0, ne1, ne2);
+        ggml_set_name(t, name.c_str());
+        gguf_add_tensor(ctx, t);
+    };
+    auto add_2d = [&](const std::string & name, int64_t ne0, int64_t ne1) {
+        ggml_tensor * t = ggml_new_tensor_2d(gctx, GGML_TYPE_F32, ne0, ne1);
+        ggml_set_name(t, name.c_str());
+        gguf_add_tensor(ctx, t);
+    };
+
+    add_2d("token_embd.weight", 64, 128);
+    for (int il = 0; il < n_total; ++il) {
+        const std::string prefix = "blk." + std::to_string(il) + ".";
+        if (n_expert > 0) {
+            if (fused_gate_up) {
+                add_3d(prefix + "ffn_gate_up_exps.weight", 64, 128, n_expert);
+            } else {
+                add_3d(prefix + "ffn_gate_exps.weight", 64, 64, n_expert);
+                add_3d(prefix + "ffn_up_exps.weight",   64, 64, n_expert);
+            }
+            add_3d(prefix + "ffn_down_exps.weight", 64, 64, n_expert);
+        } else {
+            add_2d(prefix + "ffn_gate.weight", 64, 64);
+        }
+        if (include_nextn_tensor && il >= n_trunk) {
+            add_2d(prefix + "nextn.eh_proj.weight", 128, 64);
+        }
+    }
+
+    const bool ok = gguf_write_to_file(ctx, path.c_str(), /*only_meta=*/true);
+    assert(ok);
+    ggml_free(gctx);
+    gguf_free(ctx);
+}
+
+static void write_synthetic_split_moe_gguf(
+        const std::string & shard1_path,
+        const std::string & shard2_path,
+        const std::string & arch,
+        int                 n_trunk,
+        int                 n_nextn_blocks,
+        int                 n_expert = 4) {
+    const int n_total = n_trunk + n_nextn_blocks;
+    for (int shard = 0; shard < 2; ++shard) {
+        gguf_context * ctx = gguf_init_empty();
+        assert(ctx != nullptr);
+        gguf_set_val_u16(ctx, "split.count", 2);
+        gguf_set_val_u16(ctx, "split.no", shard);
+        gguf_set_val_str(ctx, "general.architecture", arch.c_str());
+        gguf_set_val_u32(ctx, (arch + ".block_count").c_str(), n_total);
+        gguf_set_val_u32(ctx, (arch + ".expert_count").c_str(), n_expert);
+        gguf_set_val_u32(ctx, (arch + ".expert_used_count").c_str(), 1);
+        gguf_set_val_u32(ctx, (arch + ".context_length").c_str(), 4096);
+        gguf_set_val_u32(ctx, (arch + ".nextn_predict_layers").c_str(), n_nextn_blocks);
+
+        ggml_init_params gp = { ggml_tensor_overhead() * (size_t) (n_total * 5 + 8), nullptr, true };
+        ggml_context * gctx = ggml_init(gp);
+        assert(gctx != nullptr);
+
+        auto add_3d = [&](const std::string & name, int64_t ne0, int64_t ne1, int64_t ne2) {
+            ggml_tensor * t = ggml_new_tensor_3d(gctx, GGML_TYPE_F32, ne0, ne1, ne2);
+            ggml_set_name(t, name.c_str());
+            gguf_add_tensor(ctx, t);
+        };
+        auto add_2d = [&](const std::string & name, int64_t ne0, int64_t ne1) {
+            ggml_tensor * t = ggml_new_tensor_2d(gctx, GGML_TYPE_F32, ne0, ne1);
+            ggml_set_name(t, name.c_str());
+            gguf_add_tensor(ctx, t);
+        };
+
+        if (shard == 0) {
+            add_2d("token_embd.weight", 64, 128);
+            for (int il = 0; il < n_trunk; ++il) {
+                const std::string prefix = "blk." + std::to_string(il) + ".";
+                add_3d(prefix + "ffn_gate_exps.weight", 64, 64, n_expert);
+                add_3d(prefix + "ffn_up_exps.weight",   64, 64, n_expert);
+                add_3d(prefix + "ffn_down_exps.weight", 64, 64, n_expert);
+            }
+        } else {
+            for (int il = n_trunk; il < n_total; ++il) {
+                const std::string prefix = "blk." + std::to_string(il) + ".";
+                add_3d(prefix + "ffn_gate_exps.weight", 64, 64, n_expert);
+                add_3d(prefix + "ffn_up_exps.weight",   64, 64, n_expert);
+                add_3d(prefix + "ffn_down_exps.weight", 64, 64, n_expert);
+                add_2d(prefix + "nextn.eh_proj.weight", 128, 64);
+            }
+        }
+
+        const std::string & out = shard == 0 ? shard1_path : shard2_path;
+        const bool ok = gguf_write_to_file(ctx, out.c_str(), /*only_meta=*/true);
+        assert(ok);
+        ggml_free(gctx);
+        gguf_free(ctx);
+    }
+}
