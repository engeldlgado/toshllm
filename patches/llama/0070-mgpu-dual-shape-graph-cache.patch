+    // Shape cache. Each slot holds everything that only depends on the graph's shape: the
+    // per-device subgraphs, their node arrays and the sizes derived from them. Swapping slots
+    // moves that state in and out of the live members, so no mapping is rebuilt.
+    struct shape_slot_state {
+        std::vector<backend_config> backend_configs;
+        ggml_context_ptr            ctx;
+        std::vector<ggml_cgraph *>  cgraphs_aux;
+        std::vector<ggml_tensor *>  nodes_aux;
+        int      max_nnodes    = 0;
+        size_t   max_tmp_size  = 0;
+        size_t   max_subgraphs = 0;
+        size_t   n_subgraphs   = 0;
+        uint64_t uid           = 0;
+    };
+    shape_slot_state            shape_slots[2];
+    int                         shape_active = -1;
+    std::vector<ggml_backend_t> simple_backends;
+
+    void shape_swap(shape_slot_state & s) {
+        std::swap(backend_configs, s.backend_configs);
+        std::swap(ctx,             s.ctx);
+        std::swap(cgraphs_aux,     s.cgraphs_aux);
+        std::swap(nodes_aux,       s.nodes_aux);
+        std::swap(max_nnodes,      s.max_nnodes);
+        std::swap(max_tmp_size,    s.max_tmp_size);
+        std::swap(max_subgraphs,   s.max_subgraphs);
+        std::swap(n_subgraphs,     s.n_subgraphs);
+        std::swap(uid,             s.uid);
+    }
+
+    // A slot whose backend_configs are empty has never been prepared: give it the same simple
+    // backends the live state uses and let the rebuild path fill the rest.
+    void shape_prepare() {
+        if (!backend_configs.empty()) {
+            return;
+        }
+        for (ggml_backend_t b : simple_backends) {
+            backend_configs.emplace_back(b, n_reduce_steps);
+        }
+        max_nnodes    = 0;
+        max_subgraphs = 0;
+        max_tmp_size  = 0;
+        uid           = 0;
+    }
+
     ggml_backend_meta_context(ggml_backend_dev_t meta_dev, const char * params) {
         const size_t n_devs = ggml_backend_meta_dev_n_devs(meta_dev);
         n_reduce_steps = std::ceil(std::log2(n_devs));
         name = "Meta(";
-        std::vector<ggml_backend_t> simple_backends;
         backend_configs.reserve(n_devs);
         simple_backends.reserve(n_devs);
         for (size_t i = 0; i < n_devs; i++) {
@@ -1990,12 +2073,45 @@ struct ggml_backend_meta_context {
