     const int64_t t_end_us = ggml_time_us();
 
+    // Shape cache. The second scheduler plans into the buffers this one just reserved, so the
+    // pair costs graph metadata and no device memory. The two plans lay their tensors over the
+    // same memory, so a switch waits for whatever the other shape left running.
+    {
+        const char * env = getenv("TOSH_MGPU_SHAPE_CACHE");
+        if (env == nullptr || atoi(env) != 0) {
