+[[host_name("kernel_mul_mv_ptq1_0_f32_c" #NC)]] \
+kernel void kernel_mul_mv_ptq1_0_f32_c##NC( \
+        constant ggml_metal_kargs_mul_mv & args, \
+        device const char * src0, \
