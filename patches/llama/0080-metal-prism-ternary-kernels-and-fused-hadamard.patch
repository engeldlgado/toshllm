+        ushort tiisg[[thread_index_in_simdgroup]], \
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) { \
+    kernel_mul_mv_ptq1_0_f32_nc_impl<N_R0_PTQ1_0_NC, NC>(args, src0, src1, dst, shmem, tgpig, tiisg, sgitg); \
+}
