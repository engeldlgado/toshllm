+template <typename type4>
+void dequantize_pq2_0_t4(device const block_pq2_0 * xb, short il, thread type4 & reg) {
+    const uint b = xb->qs[il];
+    const float d = xb->d;
+
+    reg = (type4) ((float4(b & 3u, (b >> 2) & 3u, (b >> 4) & 3u, b >> 6) - 1.0f)*d);
