+static const ggml_tensor * ggml_metal_gdn_rows_src(const ggml_cgraph * gf, const ggml_tensor * gdn) {
+    const ggml_tensor * st = gdn->src[5];
+    if (st->ne[3] != 1 || ggml_get_op_params_i32(gdn, 0) != 1) {
+        return nullptr;
