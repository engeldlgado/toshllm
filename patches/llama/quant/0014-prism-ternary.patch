+    const int nb = args.ne00/QK_PQ2_0;
+    const int first_row = (tgpig.x * NSG + sgitg) * nr0;
+
+    device const float * y = (device const float *) src1;
+
+    uint ro[nr0];
+    for (int row = 0; row < nr0; ++row) {
+        ro[row] = (uint) ((first_row + row)*args.nb01);
+    }
+
+    float4 yl[4];
+    half2  yh[8];
+    float  sumg[nr0] = {0.f};
+    float  sumu[nr0] = {0.f};
