+            yl[c][0] = float4(y0[0], y1[0], y2[0], y3[0]);
+            yl[c][1] = float4(y0[1], y1[1], y2[1], y3[1]);
+            yl[c][2] = float4(y0[2], y1[2], y2[2], y3[2]);
+            yl[c][3] = float4(y0[3], y1[3], y2[3], y3[3]);
