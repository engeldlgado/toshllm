+        ushort sgitg[[simdgroup_index_in_threadgroup]],
+        ushort tiisg[[thread_index_in_simdgroup]]) {
+    constexpr int N   = 1024;
+    constexpr int NT  = 128;
+    constexpr int NV  = N/NT;
+    constexpr int NSG = NT/NW;
