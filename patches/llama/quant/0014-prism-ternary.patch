+            const uint o = ro[row] + ib*(uint) sizeof(block_pq2_0);
+            FOR_UNROLL (short m = 0; m < 2; m++) {
+                device const char * src0 = m == 0 ? src0g : src0u;
+                const uint w = mv_ld_u32(src0 + o + 2 + 4*il);
