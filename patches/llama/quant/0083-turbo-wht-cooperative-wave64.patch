+// Wave64 cooperative WHT: one lane owns two values and all 64 lanes cover one 128-element group.
+[[max_total_threads_per_threadgroup(64)]]
+kernel void kernel_turbo_wht_coop_w64(
+        constant ggml_metal_kargs_turbo_wht & args [[buffer(0)]],
+        device const float * src [[buffer(1)]],
+        device       float * dst [[buffer(2)]],
+        uint tgpig [[threadgroup_position_in_grid]],
+        ushort tiisg [[thread_index_in_simdgroup]]) {
+    const int64_t group_idx = tgpig;
+    const int64_t n_groups = args.n_elements / 128;
+    if (group_idx >= n_groups) return;
+
+    const bool is_inverse = (args.direction == 1);
+    constant float * sfirst = is_inverse ? turbo_wht_signs2 : turbo_wht_signs1;
+    constant float * slast  = is_inverse ? turbo_wht_signs1 : turbo_wht_signs2;
+
+    const uint l = tiisg;
+    device const float2 * in2  = (device const float2 *)(src + group_idx * 128);
+    device float2       * out2 = (device float2       *)(dst + group_idx * 128);
+
+    float2 v = in2[l];
+    v *= float2(sfirst[2*l], sfirst[2*l + 1]);
+    v = float2(v.x + v.y, v.x - v.y);
+    #pragma unroll
+    for (uint d = 1; d <= 32; d <<= 1) {
+        const float2 p = simd_shuffle_xor(v, d);
+        v = (l & d) == 0 ? v + p : p - v;
+    }
+    constexpr float inv_sqrt128 = 0.08838834764831845f;
+    v *= float2(slast[2*l] * inv_sqrt128, slast[2*l + 1] * inv_sqrt128);
+    out2[l] = v;
+}
