+// tokens per expert at which the expert tile starts beating the mat-vec, fitted per quant and
+// wave width over both routes forced on every measured shape; 0 = not measured, keep the 32 rows
+static inline float ggml_metal_mul_mat_id_tpe_floor(enum ggml_type t, int simd_width) {
+    const bool w64 = simd_width == 64;
+    switch (t) {
+        case GGML_TYPE_Q4_0:  return w64 ? 7.25f : 4.25f;
+        case GGML_TYPE_Q4_K:  return w64 ? 5.25f : 3.25f;
+        case GGML_TYPE_Q5_K:  return w64 ? 3.75f : 2.75f;
+        case GGML_TYPE_Q6_K:  return w64 ? 6.25f : 3.25f;
+        case GGML_TYPE_Q8_0:  return w64 ? 7.25f : 2.75f;
+        case GGML_TYPE_MXFP4: return w64 ? 6.25f : 7.25f;
+        default:              return 0.0f;
+    }
+}
+
+// diagnostic: predicted log(mat-vec / expert tile) for a shape, fitted per wave width over
+// both routes forced on every measured shape; positive means the tile is predicted to win
+static inline float ggml_metal_mul_mat_id_cost_margin(enum ggml_type t, int simd_width,
+        float tpe, float m, float k) {
+    const bool w64 = simd_width == 64;
+    float off = 0.0f;
+    switch (t) {
+        case GGML_TYPE_MXFP4: off = 0.0f;                     break;
+        case GGML_TYPE_Q4_0:  off = w64 ? -0.152f :  0.140f;   break;
+        case GGML_TYPE_Q4_K:  off = w64 ?  0.213f :  0.400f;   break;
+        case GGML_TYPE_Q5_K:  off = w64 ?  0.410f :  0.416f;   break;
+        case GGML_TYPE_Q6_K:  off = w64 ? -0.065f :  0.283f;   break;
+        case GGML_TYPE_Q8_0:  off = w64 ? -0.209f :  0.529f;   break;
+        default:              return 0.0f;
+    }
+    const float a = w64 ?  3.706f :  2.037f;
+    const float b = w64 ?  0.701f :  0.697f;
+    const float c = w64 ? -0.070f : -0.033f;
+    const float d = w64 ? -0.587f : -0.384f;
+    return a + b*logf(tpe) + c*logf(m) + d*logf(k) + off;
+}
+
+static inline bool ggml_metal_op_mul_mat_id_use_mm(const struct ggml_tensor * op, bool has_simdgroup_mm, int simd_width) {
+    if (!has_simdgroup_mm || op->src[0]->ne[0] < 64) {
+        return false;
+    }
+    // diagnostic: TOSH_MMID_MM_FLOOR=<rows> forces a fixed row floor (1 = always the tile,
+    // 4096 = never); the tokens-per-expert rule below is opt-in with TOSH_MMID_POLICY=tpe,
+    // so by default the switch stays the production 32-row one
+    static int diag_floor = -1;
+    static int diag_tpe   = -1;
+    if (diag_floor < 0) {
+        const char * s = getenv("TOSH_MMID_MM_FLOOR");
+        diag_floor = s ? (atoi(s) > 0 ? atoi(s) : 1) : 0;
+        const char * p = getenv("TOSH_MMID_POLICY");
+        diag_tpe   = p ? (p[0] == 't' ? 1 : (p[0] == 'c' ? 2 : 0)) : 0;
+    }
+    if (diag_floor > 0) {
+        return op->src[2]->ne[1] >= diag_floor;
+    }
+    if (!diag_tpe) {
+        return op->src[2]->ne[1] >= 32;
+    }
+    const float tpe_all = op->src[0]->ne[2] > 0
+        ? (float) (op->src[2]->ne[1]*op->src[2]->ne[0]) / (float) op->src[0]->ne[2]
+        : 0.0f;
+    if (diag_tpe == 2) {
+        // a single row floor cannot hold: the crossover moves with the expert width and depth
+        // as well as with the rows, so predict which route is cheaper for this shape
+        if (tpe_all <= 0.0f) {
+            return op->src[2]->ne[1] >= 32;
+        }
+        const float margin = ggml_metal_mul_mat_id_cost_margin(op->src[0]->type, simd_width,
+                tpe_all, (float) op->src[0]->ne[1], (float) op->src[0]->ne[0]);
+        return margin != 0.0f ? margin > 0.0f : op->src[2]->ne[1] >= 32;
+    }
+    // the crossover follows how many rows each expert gets, not the batch: a fixed row count
+    // switches too early with many experts and too late with few
+    const float floor = ggml_metal_mul_mat_id_tpe_floor(op->src[0]->type, simd_width);
+    if (floor <= 0.0f || op->src[0]->ne[2] <= 0) {
+        return op->src[2]->ne[1] >= 32;
+    }
+    return tpe_all >= floor;
 }
 
 #ifdef __cplusplus
 }
 #endif
