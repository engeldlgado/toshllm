+    const float wscale;
+    test_mul_mat_id_big(float wscale, ggml_type type_a, int n_mats, int n_used, int64_t m, int64_t n, int64_t k)
+        : test_mul_mat_id(type_a, GGML_TYPE_F32, n_mats, n_used, false, m, n, k), wscale(wscale) {}
+    std::string vars() override { return test_mul_mat_id::vars() + ",wscale=" + std::to_string((int) wscale); }
+    void initialize_tensors(ggml_context * ctx) override {
+        init_mul_mat_id_tensors(ctx, n_mats, skip);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "as") == 0) { init_tensor_uniform(t, -wscale, wscale); }
+        }
+    }
+};
