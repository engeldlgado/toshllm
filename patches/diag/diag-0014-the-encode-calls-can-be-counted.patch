diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index 2ac344a56..d8b6aaebb 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -877,11 +877,58 @@ struct ggml_metal_pipeline_with_params ggml_metal_library_compile_pipeline(ggml_
 
 struct ggml_metal_encoder {
     id<MTLComputeCommandEncoder> obj;
 };
 
+// diagnostic: TOSH_ENC_COUNT=1 counts and times the encode calls by category, so the host gap
+// can be split between the calls themselves and what surrounds them
+static _Atomic uint64_t g_enc_n[8];
+static _Atomic uint64_t g_enc_ns[8];
+enum { ENC_INIT = 0, ENC_PIPE, ENC_BYTES, ENC_BUF, ENC_TGMEM, ENC_DISP, ENC_BARRIER, ENC_END };
+
+static bool tosh_enc_count_on(void) {
+    static int st = 0;
+    if (st == 0) {
+        const char * e = TOSH_ENV("TOSH_ENC_COUNT");
+        st = (e && strcmp(e, "0") != 0) ? 2 : 1;
+    }
+    return st == 2;
+}
+
+static inline uint64_t tosh_enc_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec*1000000000ull + ts.tv_nsec;
+}
+
+static void tosh_enc_report(void) {
+    static const char * names[8] = { "encoder init", "set pipeline", "set bytes", "set buffer",
+                                     "threadgroup mem", "dispatch", "barrier", "end encoding" };
+    uint64_t tot = 0;
+    for (int i = 0; i < 8; ++i) {
+        tot += atomic_load(&g_enc_ns[i]);
+    }
+    fprintf(stderr, "TOSH_ENC_COUNT total %.3f ms in the encode calls\n", tot/1e6);
+    for (int i = 0; i < 8; ++i) {
+        const uint64_t n = atomic_load(&g_enc_n[i]);
+        const uint64_t t = atomic_load(&g_enc_ns[i]);
+        if (n) {
+            fprintf(stderr, "TOSH_ENC_COUNT   %-16s %10llu calls  %9.3f ms  %7.1f ns/call  %5.1f%%\n",
+                    names[i], (unsigned long long) n, t/1e6, (double) t/n, tot ? 100.0*t/tot : 0.0);
+        }
+    }
+}
+
+#define TOSH_ENC_T0() const bool _ec = tosh_enc_count_on(); const uint64_t _t0 = _ec ? tosh_enc_now() : 0
+#define TOSH_ENC_T1(k) do { if (_ec) { \
+        static _Atomic int _once = 0; int _e = 0; \
+        if (atomic_compare_exchange_strong(&_once, &_e, 1)) { atexit(tosh_enc_report); } \
+        atomic_fetch_add(&g_enc_n[k], 1); \
+        atomic_fetch_add(&g_enc_ns[k], tosh_enc_now() - _t0); } } while (0)
+
