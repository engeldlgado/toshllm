     id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
 
     if (concurrent) {
@@ -890,10 +937,12 @@ ggml_metal_encoder_t ggml_metal_encoder_init(ggml_metal_cmd_buf_t cmd_buf_raw, b
         res->obj = [cmd_buf computeCommandEncoder];
     }
 
     [res->obj retain];
 
+    TOSH_ENC_T1(ENC_INIT);
+
     return res;
 }
 
