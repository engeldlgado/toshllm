     [encoder->obj release];
@@ -909,35 +958,49 @@ void ggml_metal_encoder_debug_group_push(ggml_metal_encoder_t encoder, const cha
 void ggml_metal_encoder_debug_group_pop (ggml_metal_encoder_t encoder) {
     [encoder->obj popDebugGroup];
 }
 
