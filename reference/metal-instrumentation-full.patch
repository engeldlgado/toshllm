+// TOSH_CB_PROFILE: VRAM que el driver tiene asignada de verdad, contra la recomendada, y el
+// RSS del proceso. Prioridad 5 pide distinguir asignada de residente y de memoria del host.
+void tosh_device_mem_report(ggml_metal_device_t dev, const char * tag) {
+    if (getenv("TOSH_CB_PROFILE") == NULL) {
+        return;
+    }
+    struct rusage ru;
+    getrusage(RUSAGE_SELF, &ru);
+    if (@available(macOS 10.12, *)) {
+        fprintf(stderr, "TOSH_MEM  %-10s vram_asignada=%.2f GiB  vram_recomendada=%.2f GiB  rss_max=%.2f GiB\n",
+                tag,
+                dev->mtl_device.currentAllocatedSize/1073741824.0,
+                dev->mtl_device.recommendedMaxWorkingSetSize/1073741824.0,
+                ru.ru_maxrss/1073741824.0);
+    }
+}
